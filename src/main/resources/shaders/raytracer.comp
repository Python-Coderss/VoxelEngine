            }
        }

        // ── Toon rim light ──
        // Grazing-angle edge highlight (classic cel-shading accent) tinted by the
        // ambient+sun mix, so silhouette edges pop against the banded sky. Opaque
        // surfaces only — water/glass reflections and translucency are untouched.
        if (trans < 0.01) {
            float rv = 1.0 - max(0.0, dot(n, -rd));
            beam += mix(at.ambient, at.sunColor, 0.5) * (rv * rv * rv) * 0.35;
        }

        // Camera clipped inside water: the primary hit is the water voxel we're
        // inside at t≈0 — drop its shading entirely (no stretched near-surface
        // texture). The medium tag below still switches to water, so the next
        // trace skips the whole water column and fog/tint carry the look.
        if (skipNearWater) { trans = 1.0; alb = vec3(1.0); refl = 0.0; }

        vec3 bc = alb * beam * max(0.0, 1.0 - trans - refl);
        float fog = 1.0 - exp(-t * 0.003); bc = mix(bc, haze, fog);
        // Compute medium tag for face culling between same-medium translucent blocks.
        // Groups all water variants (15, 150-156) as tag 1, lava (21) as tag 2,
        // and uses block ID as tag for all other translucent blocks (e.g., glass).
        uint mediumTag = voxel;
        if (!isEnt) {
            // Reuse the block-data d1 threaded out of traceWorld (no redundant texelFetch)
            int eff = (blockData1.w >> 10) & 0xF;
            if (eff == 2) { // LIQUID
                // Differentiate water (tag=1) from lava (tag=2)
                mediumTag = (voxel == 21u) ? 2u : 1u;
            }
        }

        // Skip face and tint accumulation between same-medium translucent blocks
        // (e.g., water-water, flowing water-water source, glass-glass)
        if (trans > 0.0 && !isEnt && mediumTag == lastMediumTag) {
            bc = vec3(0.0);
        } else if (trans > 0.0) {
            // Additive color mixing: stack tints instead of multiplying them to avoid dimming
            final += throu * alb * (1.0 - trans);
            throu *= trans * alb;
        }
        final += throu * bc;

        // Transmission/refl: set up next ray. Only LIQUID surfaces whose reflection
        // exceeds transmission (water at grazing angles) reflect; other transparent
        // blocks (glass/ice) keep the classic transmit path.
        if (trans > 0.0 && (refl <= trans || waterEff != 2)) {
            if (!isEnt) lastMediumTag = mediumTag;
            ro = hp + rd * 0.01; skip = true;
        }
        else if (refl > 0.0) { throu *= refl; ro = hp + n * 0.01; rd = reflect(rd, n); skip = false; }
        else break;
    }
    
    // God rays: volumetric shafts from the ACTIVE sun/moon light pools. March the
    // primary ray up to its first hit; shafts only accumulate in air gaps.
    if (godT > 0.5) final += marchLightShafts(camPos, godRd, min(godT, 96.0), at);

    // Underwater: distance fog into deep blue — a shader-style post-pass that
    // makes the view readable when the camera is clipped inside water.
    if (underWater) {
        float fogDist = godT;
        if (godT >= 95.0 && godRd.y > 0.001) {
            // Looking up through the surface: fog by the water thickness above
            // the eye, not the (infinite) sky distance, so the surface stays bright.
            fogDist = max(0.2, (ceil(camPos.y + 0.001) - camPos.y) / godRd.y);
        }
        float vis = 1.0 - exp(-fogDist * 0.05);
        vec3 waterFog = vec3(0.015, 0.16, 0.26);
        final = mix(final, waterFog, clamp(0.12 + vis * 0.85, 0.0, 0.94));
    }
    
    vec3 result = ACESFilm(final);
    // Cartoon grade on the scene only (UI alpha-blended afterwards, fullscreen
    // UI early-outs before this): saturation boost + 12-level posterize.
    // Band edges use a narrow smoothstep blend instead of a hash dither — the
    // old dither showed up as grain on dark surfaces, this stays clean.
    float lum = dot(result, vec3(0.299, 0.587, 0.114));
    result = mix(vec3(lum), result, 1.06); // subtle pop; 1.18 oversaturated ("deep-fried")
    if (uiCol.a < 0.5) {
        // 12-level posterize with a wider soft blend at the band edges
        vec3 scaled = clamp(result * 12.0, 0.0, 11.0);
        vec3 lo = floor(scaled);
        vec3 frac = scaled - lo;
        vec3 hi = min(lo + 1.0, 11.0);
        result = mix(lo, hi, smoothstep(0.38, 0.62, frac)) / 12.0;
    }
    if (uiCol.a > 0.0) result = mix(result, uiCol.rgb, uiCol.a);
    imageStore(imgOutput, px, vec4(linearToSrgb(result), 1.0));
}
