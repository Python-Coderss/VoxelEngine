#version 430 core

/**
 * Optimized Voxel RTX Shader with Unified 64x64 Texture Support.
 */

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba8, binding = 0) uniform image2D imgOutput;

// Uniforms
layout(location = 0) uniform vec3 _camFrac;
layout(location = 1) uniform vec3 camForward;
layout(location = 2) uniform vec3 camRight;
layout(location = 3) uniform vec3 camUp;
layout(location = 4) uniform float u_Time;
layout(location = 10) uniform int u_DimensionID;
layout(location = 11) uniform int u_CraftingItemCount;

// Pre-computed atmosphere uniforms (set by AtmosphereRenderer on CPU)
layout(location = 12) uniform vec3 u_SunDir;
layout(location = 13) uniform vec3 u_SunColor;
layout(location = 14) uniform vec3 u_MoonDir;
layout(location = 15) uniform vec3 u_MoonColor;
layout(location = 16) uniform vec3 u_SkyZenith;
layout(location = 17) uniform vec3 u_SkyHorizon;
layout(location = 18) uniform vec3 u_Ambient;

// SSBOs
layout(std430, binding = 1) buffer readonly restrict IndirectionTable { uint chunkSlots[]; };
layout(std430, binding = 2) buffer readonly restrict ChunkPool { uint voxelPool[]; };
layout(std430, binding = 3) buffer readonly restrict BitmaskPool { uint bitmasks[]; };
layout(std430, binding = 4) buffer readonly restrict OcclusionPool { uint occlusionPool[]; };

// Block light propagation: Minecraft packed format [sky(0-3)|block(4-7)] per voxel
layout(std430, binding = 9) buffer readonly restrict LightPool { uint lightPool[]; };

layout(location = 29) uniform ivec3 _camBlock;

// Reconstructed camera position in buffer-relative space (always in [0,2048] range).
// _camBlock is relative to u_WorldOffset, so vec3(_camBlock) + _camFrac has full
// float32 sub-block precision at any world coordinate (Far Lands safe).
vec3 camPos = vec3(_camBlock) + _camFrac;

// Camera eye voxel (buffer-relative) solidity — recomputed per invocation in
// main() from the GPU pools (same bitmask the per-voxel DDA uses), so no CPU→GPU
// uniform handoff can go stale and silently disable the camera-clip fix.
// True when the eye sits inside ANY bit-solid voxel (solid block, water, lava);
// that one voxel is then treated as air on the first bounce (see airVoxel).
bool camClipped = false;

// Chunk-level SDF pool for sphere-trace acceleration.
// 4096 SDF cells packed 4-per-uint, indexed as sdfPool[(slot << 10) | (cellIdx>>2)].
// Each uint holds 4 bytes of distance values, value = round(dist_voxels * 8),
// capped at 255. cellIdx = lx | (ly<<4) | (lz<<8). Distances are relative to
// the nearest SOLID voxel within the same chunk section — for empty chunks
// (slot == EMPTY in chunkSlots), the skipChunk() path handles traversal.
layout(std430, binding = 10) buffer readonly restrict SdfPool { uint sdfPool[]; };

// Block break overlay uniforms
layout(location = 19) uniform ivec3 u_BreakTargetPos;
layout(location = 20) uniform float u_BreakProgress;
layout(location = 21) uniform int u_DestroyBaseLayer;

// Point Lights
struct PointLight { vec3 position; float radius; vec3 color; float intensity; };
layout(std430, binding = 5) buffer readonly restrict PointLightBuffer { 
    int numPointLights; 
    int pl_pad1, pl_pad2, pl_pad3; 
    PointLight pointLights[];
};

// 16 baked light pools (8 sun-trajectory + 8 moon-trajectory): ortho depth maps of
// the world from fixed light directions, regenerated ~20Hz. No surface sun shadows —
// the main pass samples the ACTIVE sun/moon pools only for volumetric god rays.
layout(r32f, binding = 1) uniform writeonly image2D u_ShadowMapOut;
layout(location = 22) uniform int u_ShadowPass;      // 0=main, 1=light-pool gen
layout(location = 23) uniform vec3 u_ShadowOrigin;   // ACTIVE SUN pool near-plane origin (buffer-relative)
layout(location = 24) uniform vec3 u_ShadowRight;    // ACTIVE SUN pool right basis (unit length)
layout(location = 25) uniform vec3 u_ShadowUp;       // ACTIVE SUN pool up basis (unit length)
layout(location = 26) uniform vec3 u_ShadowSunDir;   // ACTIVE SUN pool light direction
layout(location = 27) uniform vec2 u_ShadowExtent;   // (half-extent blocks, depth blocks)
layout(location = 30) uniform float u_ShadowMapSize; // 1.0 / pool resolution
layout(location = 31) uniform sampler2D u_SunPoolTex;
layout(location = 32) uniform sampler2D u_MoonPoolTex;
layout(location = 33) uniform vec3 u_MoonPoolOrigin; // ACTIVE MOON pool near-plane origin
layout(location = 34) uniform vec3 u_MoonPoolRight;  // ACTIVE MOON pool right basis
layout(location = 35) uniform vec3 u_MoonPoolUp;     // ACTIVE MOON pool up basis
layout(location = 36) uniform vec3 u_MoonPoolDir;    // ACTIVE MOON pool light direction
layout(location = 37) uniform int u_UnderWater;       // 1 = camera eye inside a water block
layout(location = 38) uniform int u_LargeCogPresent;  // 1 when any large cogwheel (295) is loaded

// Semi-transparent block placement preview (ghost). Buffer-relative target cell
// (39), block id (40, -1 = off), and facing (41) for directional blocks.
layout(location = 39) uniform ivec3 u_PreviewPos;
layout(location = 40) uniform int u_PreviewBlock;
layout(location = 41) uniform int u_PreviewFacing;

// ── Map preview (simplified biome view for unloaded chunks) ──
// When the map is open (top-down camera), a ray that enters an EMPTY
// (unloaded) chunk column samples a CPU-generated preview texture instead of
// falling through to the void: flat biome colors at ~1-6 blocks/texel. Past
// the world border the preview is void (alpha 0), so the map "stops working"
// exactly at the world size. All coordinates are buffer-relative, matching the
// DDA voxel space (u_MapWorldOrigin is the buffer's world XZ origin).
layout(location = 42) uniform int u_MapMode;
layout(location = 43) uniform vec2 u_MapPreviewOrigin; // buffer-relative XZ of texel (0,0)
layout(location = 44) uniform float u_MapPreviewScale; // blocks per texel
layout(location = 45) uniform vec2 u_MapWorldOrigin;   // world XZ of buffer (0,0)
layout(location = 46) uniform float u_MapBorder;       // world border radius (half width)
layout(location = 47) uniform sampler2D u_MapPreview;
layout(location = 48) uniform float u_MapGroundY;      // buffer-relative Y of the map's ground plane (world sea level)
const float MAP_PREVIEW_TEXELS = 256.0; // must match WorldMapRenderer.TEX_SIZE

// Set by traceWorld() when a downward map ray crosses an EMPTY chunk inside the
// preview region; consumed by the miss path in main() (preview instead of sky).
vec3 gMapPreviewCol = vec3(0.0);
bool gMapPreviewValid = false;

// Entities
struct EntityData { vec3 position; float health; vec3 rotation; float maxHealth; int partCount; int partOffset; float hitFlash; float tintR; float tintG; float tintB; float tintAmount; float padding; };
struct PartData {
    vec3 offset; float uvU;
    vec3 absoluteOffset; float uvV;
    vec3 size; float textureIndex;
    vec3 rotation; vec3 uvSize; float textureMapping;
    float emissive; float padding0; float padding1; float padding2;
};
layout(std430, binding = 6) buffer readonly restrict EntityBuffer { EntityData entities[]; };
layout(std430, binding = 7) buffer readonly restrict PartBuffer { PartData parts[]; };
layout(location = 5) uniform int u_EntityCount;

// Crafting Items (3D miniature blocks on the crafting table surface)
// position.xyz = center, position.w = blockId (as int bits)
// blockInfo.x = scale (e.g. 0.125 for 1/8 scale filling one cell)
struct CraftingItem { vec4 position; vec4 blockInfo; };
layout(std430, binding = 8) buffer readonly restrict CraftingItemBuffer { CraftingItem craftingItems[]; };

// Samplers
uniform sampler2DArray u_BlockTextures;
uniform sampler2DArray u_EntityTextures;
uniform isamplerBuffer u_BlockData;
uniform samplerBuffer u_BlockAABBs;
uniform isamplerBuffer u_BlockAABBInfo;
uniform isamplerBuffer u_BlockAABBUVs;
uniform sampler2D u_BiomeMap;
uniform sampler2D u_UITexture;
uniform sampler2D u_UISource;
uniform sampler2DArray u_DestroyStages;



layout(location = 7) uniform vec4 u_HeartUVs[3]; // [0]=Full, [1]=Half, [2]=Empty

const int WORLD_SIZE = 2048;
const uint EMPTY = 0xFFFFFFFF;
const float PI = 3.14159265359;

struct Atmosphere { vec3 sunDir, moonDir, sunColor, moonColor, skyZenith, skyHorizon, ambient; };

// Dimension IDs
const int DIM_OVERWORLD = 0;
const int DIM_NETHER = 1;
const int DIM_END = 2;
const int DIM_AETHER = 3;

Atmosphere GetAtmosphere(float t) {
    Atmosphere at;
    
    if (u_DimensionID == DIM_NETHER) {
        // Nether: No day/night cycle, red/orange fog
        at.sunDir = normalize(vec3(0.0, -0.5, 0.0));
        at.moonDir = normalize(vec3(0.0, 0.5, 0.0));
        at.skyZenith = vec3(0.3, 0.05, 0.02);
        at.skyHorizon = vec3(0.5, 0.15, 0.05);
        at.sunColor = vec3(0.6, 0.2, 0.05);
        at.moonColor = vec3(0.0);
        at.ambient = vec3(0.08, 0.03, 0.01);
        return at;
    }
    
    if (u_DimensionID == DIM_END) {
        // End: Dark with purple fog, no sun
        at.sunDir = normalize(vec3(0.0, 1.0, 0.0));
        at.moonDir = normalize(vec3(0.0, -1.0, 0.0));
        at.skyZenith = vec3(0.01, 0.0, 0.05);
        at.skyHorizon = vec3(0.05, 0.02, 0.1);
        at.sunColor = vec3(0.1, 0.05, 0.15);
        at.moonColor = vec3(0.0);
        at.ambient = vec3(0.02, 0.01, 0.04);
        return at;
    }
    
    if (u_DimensionID == DIM_AETHER) {
        // Aether: Bright, always daytime
        at.sunDir = normalize(vec3(0.0, 1.0, 0.3));
        at.moonDir = -at.sunDir;
        at.skyZenith = vec3(0.4, 0.7, 0.95);
        at.skyHorizon = vec3(0.7, 0.85, 0.95);
        at.sunColor = vec3(1.0, 0.98, 0.9);
        at.moonColor = vec3(0.0);
        at.ambient = vec3(0.3, 0.35, 0.4);
        return at;
    }
    
    // Overworld (default): Day/night cycle
    float cycle = fract(t / 1440.0);
    float angle = cycle * 2.0 * PI - (PI * 0.5);
    at.sunDir = normalize(vec3(cos(angle), sin(angle), 0.3)); at.moonDir = -at.sunDir;
    float h = at.sunDir.y;
    at.skyZenith = mix(vec3(0.01, 0.02, 0.05), vec3(0.1, 0.35, 0.75), smoothstep(-0.15, 0.15, h));
    at.skyHorizon = mix(vec3(0.02, 0.03, 0.08), mix(vec3(0.9, 0.4, 0.2), vec3(0.5, 0.7, 0.9), smoothstep(0.0, 0.3, h)), smoothstep(-0.15, 0.1, h));
    at.sunColor = mix(vec3(1.0, 0.5, 0.2), vec3(1.0, 0.98, 0.9), smoothstep(0.0, 0.4, h)) * smoothstep(-0.1, 0.1, h);
    at.moonColor = vec3(0.2, 0.25, 0.4) * smoothstep(-0.1, 0.1, -h);
    at.ambient = mix(vec3(0.02, 0.03, 0.07), at.skyZenith * 0.4, smoothstep(-0.2, 0.2, h));
    return at;
}

vec3 ACESFilm(vec3 x) { return clamp((x*(2.51*x + 0.03))/(x*(2.43*x + 0.59) + 0.14), 0.0, 1.0); }

// The light pool and all scene math are linear-light. Encode to sRGB exactly
// once at the output instead of applying an approximate power curve to the
// block-light term (which makes low-level light look washed out and double-
// corrects it when the scene is tone-mapped).
vec3 linearToSrgb(vec3 linear) {
    linear = max(linear, vec3(0.0));
    vec3 low = linear * 12.92;
    vec3 high = 1.055 * pow(linear, vec3(1.0 / 2.4)) - 0.055;
    return mix(high, low, step(linear, vec3(0.0031308)));
}

// LightEngine stores Minecraft's 0..15 levels as 0..255 channels (level * 17),
// with a four-source headroom divisor. Decode the raw channel before the scene
// is tone-mapped. The 0 and 255 endpoints stay unchanged.
float decodeBlockLight(float encodedChannel) {
    return pow(clamp(encodedChannel / 255.0, 0.0, 1.0), 2.2) * 255.0;
}

// ── Cartoon-style helpers ──
// Deterministic screen-space hash (dither + volumetric shaft detail).
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// 3-tone cel ramp for directional light: shadow / mid / lit bands with soft
// transitions (smoothstep instead of hard steps — keeps the toon look without
// harsh "deep-fried" band edges). Light INTENSITY only — albedo, transparency
// and reflection factors are untouched, so glass/water/reflections keep their
// current look.
float celRamp(float x) {
    float s = smoothstep(0.05, 0.18, x);
    float m = smoothstep(0.35, 0.55, x);
    return mix(mix(0.24, 0.66, s), 1.0, m);
}

// Animated caustic pattern (wave interference) — Minecraft-shader style light
// patterns that shimmer on sunlit floors beneath water.
float causticAt(vec3 p) {
    float t = u_Time * 1.1;
    vec2 uv = p.xz * 1.6;
    float c = sin(uv.x * 2.1 + t * 1.4) * sin(uv.y * 1.7 - t * 1.1)
            + sin((uv.x + uv.y) * 2.7 + t * 0.8) * 0.5;
    return smoothstep(0.4, 1.9, c * 0.9 + 0.5);
}

vec3 GetSky(vec3 rd, Atmosphere at) {
    float d = max(0.0, rd.y);
    // Cartoon sky: 5 horizontal color bands with soft edges (keeps the horizon
    // warm/cool split, but flat and posterized instead of a smooth gradient).
    float h = pow(d, 0.7) * 5.0;
    float bandF = fract(h);
    float blend = clamp((floor(h) + smoothstep(0.0, 0.14, bandF)) / 5.0, 0.0, 1.0);
    vec3 sky = mix(at.skyHorizon, at.skyZenith, blend);
    // Crisp cartoon sun disc + gentle warm halo (kept from blowing out)
    float sd = dot(rd, at.sunDir);
    sky += at.sunColor * (smoothstep(0.9993, 0.9997, sd) * 3.5 + pow(max(sd, 0.0), 10.0) * 0.22);
    // Moon disc
    float md = dot(rd, at.moonDir);
    sky += at.moonColor * smoothstep(0.9993, 0.9997, md) * 3.0;
    return sky;
}

// Volumetric haze: banded sky color with a sun-facing scattering boost so
// light beams read as glowing air (cartoon volumetric atmosphere).
vec3 hazeColor(vec3 rd, Atmosphere at) {
    vec3 haze = GetSky(rd, at);
    float sunF = pow(max(0.0, dot(rd, at.sunDir)), 3.0);
    haze = mix(haze, at.sunColor + at.skyHorizon, sunF * 0.35);
    return haze;
}

bool intersectAABB(vec3 ro, vec3 rd, vec3 bMin, vec3 bMax, out float tn, out float tf) {
    vec3 inv = 1.0 / rd;
    vec3 t0 = (bMin - ro) * inv, t1 = (bMax - ro) * inv;
    vec3 mi = min(t0, t1), ma = max(t0, t1);
    tn = max(max(mi.x, mi.y), mi.z);
    tf = min(min(ma.x, ma.y), ma.z);
    return tn <= tf && tf > 0.0;
}

mat3 rotateX(float a) {
    float s = sin(a), c = cos(a);
    return mat3(1,0,0, 0,c,s, 0,-s,c);
}

mat3 rotateY(float a) {
    float s = sin(a), c = cos(a);
    return mat3(c,0,-s, 0,1,0, s,0,c);
}

mat3 rotateZ(float a) {
    float s = sin(a), c = cos(a);
    return mat3(c,s,0, -s,c,0, 0,0,1);
}

mat3 rotationMatrix(vec3 euler) {
    return rotateZ(euler.z) * rotateY(euler.y) * rotateX(euler.x);
}

// Remap full-block planar UVs for directional blocks based on facing direction.
// faceType: 0=X-face, 1=Y-face, 2=Z-face.
// facingDir: 0=down, 1=up, 2=north, 3=south, 4=west, 5=east.
// Returns the remapped UV coordinate.
vec2 remapDirectionalUV(vec2 uv, int faceType, int facingDir) {
    float u = uv.x, v = uv.y;
    if (facingDir == 2) { // NORTH
        if (faceType == 0) return vec2(1.0 - v, 1.0 - u);  // X-face: swap + flip both
        if (faceType == 1) return vec2(u, 1.0 - v);         // Y-face: flip V
    }
    if (facingDir == 3) { // SOUTH
        if (faceType == 0) return vec2(v, u);               // X-face: swap
    }
    if (facingDir == 4) { // WEST
        if (faceType == 1) return vec2(1.0 - v, 1.0 - u);   // Y-face: swap + flip both
        if (faceType == 2) return vec2(1.0 - v, 1.0 - u);   // Z-face: swap + flip both
    }
    if (facingDir == 5) { // EAST
        if (faceType == 1) return vec2(v, u);               // Y-face: swap
        if (faceType == 2) return vec2(v, u);               // Z-face: swap
    }
    if (facingDir == 0) { // DOWN
        if (faceType == 0) return vec2(u, 1.0 - v);  // X-face: flip V → head at bottom
        if (faceType == 2) return vec2(u, 1.0 - v);  // Z-face: flip V → head at bottom
    }
    // default: standard mapping
    return uv;
}

// Create directional machine block IDs: encased fan (263), crushing wheel (409),
// mechanical drill (410), mechanical saw (411), deployer (412), belt conveyor (413).
// Their facing is stored per-voxel in extra-data bits 16-18 (see BlockInteraction).
bool isDirectionalMachineBlock(int id) {
    return id == 263 || id == 409 || id == 410 || id == 411 || id == 412 || id == 413;
}

// Remap a world-space face to the canonical model face for a directional machine
// whose model JSON puts its "front" texture on the +X (east, face 5) face.
// facing: 0=down, 1=up, 2=north, 3=south, 4=west, 5=east. The returned face is the
// model face whose texture should be drawn on the hit `face`, so the front texture
// always lands on the world face the machine points at. This is a rigid cube
// rotation: east->facing with up preserved for horizontal facings.
int remapDirectionalFace(int face, int facing) {
    if (facing == 5) return face;               // east: identity
    if (facing == 4) {                          // west: 180° about Y
        if (face == 2) return 3;
        if (face == 3) return 2;
        if (face == 4) return 5;
        if (face == 5) return 4;
        return face;
    }
    if (facing == 2) {                          // north
        if (face == 2) return 5;
        if (face == 3) return 4;
        if (face == 4) return 2;
        if (face == 5) return 3;
        return face;
    }
    if (facing == 3) {                          // south
        if (face == 2) return 4;
        if (face == 3) return 5;
        if (face == 4) return 3;
        if (face == 5) return 2;
        return face;
    }
    if (facing == 1) {                          // up
        if (face == 0) return 4;
        if (face == 1) return 5;
        if (face == 4) return 1;
        if (face == 5) return 0;
        return face;
    }
    // facing == 0 (down)
    if (face == 0) return 5;
    if (face == 1) return 4;
    if (face == 4) return 0;
    if (face == 5) return 1;
    return face;
}

bool intersectOrientedBox(vec3 ro, vec3 rd, vec3 center, vec3 halfSize, mat3 rotation, out float hitT, out vec3 hitNormal, out vec3 hitLocalPos, out vec3 hitLocalNormal) {
    mat3 invRotation = transpose(rotation);
    vec3 localRo = invRotation * (ro - center);
    vec3 localRd = invRotation * rd;

    float tn, tf;
    if (!intersectAABB(localRo, localRd, -halfSize, halfSize, tn, tf)) return false;

    hitT = tn > 0.0 ? tn : tf;
    hitLocalPos = localRo + localRd * hitT;
    vec3 scaledAbs = abs(hitLocalPos / max(halfSize, vec3(0.0001)));

    if (scaledAbs.x > scaledAbs.y && scaledAbs.x > scaledAbs.z) {
        hitLocalNormal = vec3(sign(hitLocalPos.x), 0.0, 0.0);
    } else if (scaledAbs.y > scaledAbs.z) {
        hitLocalNormal = vec3(0.0, sign(hitLocalPos.y), 0.0);
    } else {
        hitLocalNormal = vec3(0.0, 0.0, sign(hitLocalPos.z));
    }

    hitNormal = normalize(rotation * hitLocalNormal);
    return true;
}

vec2 entityPlanarUv(vec3 localPos, vec3 localNormal, vec3 halfSize) {
    vec3 p = clamp((localPos + halfSize) / max(halfSize * 2.0, vec3(0.0001)), 0.0, 1.0);
    if (abs(localNormal.x) > 0.5) return vec2(p.z, 1.0 - p.y);
    if (abs(localNormal.y) > 0.5) return vec2(p.x, p.z);
    return vec2(p.x, 1.0 - p.y);
}

vec2 entityCuboidAtlasUvScaled(vec3 localPos, vec3 localNormal, vec3 halfSize, PartData part, float atlasSize) {
    vec3 p = clamp((localPos + halfSize) / max(halfSize * 2.0, vec3(0.0001)), 0.0, 1.0);

    // Geometry may be inflated (Minecraft wool layers), but its atlas UVs
    // still use the original uninflated cuboid dimensions.
    float w = part.uvSize.x;
    float h = part.uvSize.y;
    float d = part.uvSize.z;

    vec2 p0, p1, uvInFace;
    vec2 uvOrigin = vec2(part.uvU, part.uvV);

    // Standard Minecraft Skin Layout:
    if (localNormal.y > 0.5) { // TOP (+Y)
        p0 = uvOrigin + vec2(d, 0.0);
        p1 = p0 + vec2(w, d);
        uvInFace = vec2(p.x, p.z);
    } else if (localNormal.y < -0.5) { // BOTTOM (-Y)
        p0 = uvOrigin + vec2(d + w, 0.0);
        p1 = p0 + vec2(w, d);
        uvInFace = vec2(p.x, 1.0 - p.z);
    } else if (localNormal.x > 0.5) { // RIGHT (+X)
        p0 = uvOrigin + vec2(0.0, d);
        p1 = p0 + vec2(d, h);
        uvInFace = vec2(1.0 - p.z, 1.0 - p.y);
    } else if (localNormal.z > 0.5) { // FRONT (+Z)
        p0 = uvOrigin + vec2(d, d);
        p1 = p0 + vec2(w, h);
        uvInFace = vec2(p.x, 1.0 - p.y);
    } else if (localNormal.x < -0.5) { // LEFT (-X)
        p0 = uvOrigin + vec2(d + w, d);
        p1 = p0 + vec2(d, h);
        uvInFace = vec2(p.z, 1.0 - p.y);
    } else { // BACK (-Z)
        p0 = uvOrigin + vec2(d * 2.0 + w, d);
        p1 = p0 + vec2(w, h);
        uvInFace = vec2(1.0 - p.x, 1.0 - p.y);
    }

    return (p0 + uvInFace * (p1 - p0)) / atlasSize;
}

vec2 entityCuboidAtlasUv(vec3 localPos, vec3 localNormal, vec3 halfSize, PartData part) {
    return entityCuboidAtlasUvScaled(localPos, localNormal, halfSize, part, 64.0);
}

vec2 entityVirtualCuboidAtlasUv(vec3 localPos, vec3 localNormal, vec3 halfSize, PartData part) {
    return entityCuboidAtlasUvScaled(localPos, localNormal, halfSize, part, 128.0);
}

// ── Chunk-entry skip: compute world-space chunk AABB from packed origin coords ──
// Used by main() to jump DDA to the rasterized chunk entry point
void getChunkAABB(uint packedv, out vec3 bMin, out vec3 bMax) {
    ivec3 chunkCoord = ivec3(int(packedv & 0xFFu), int((packedv >> 8) & 0xFFu), int((packedv >> 16) & 0xFFu));
    bMin = vec3(chunkCoord) * 16.0;
    bMax = bMin + 16.0;
}

int advanceDDA(inout ivec3 mp, inout vec3 sd, vec3 dd, ivec3 s) {
    int side = (sd.x < sd.y) ? (sd.x < sd.z ? 0 : 2) : (sd.y < sd.z ? 1 : 2);
    if (side == 0) { sd.x += dd.x; mp.x += s.x; }
    else if (side == 1) { sd.y += dd.y; mp.y += s.y; }
    else { sd.z += dd.z; mp.z += s.z; }
    return side;
}

int skipChunk(inout ivec3 mp, inout vec3 sd, vec3 dd, ivec3 s) {
    ivec3 lp = mp & 15;
    ivec3 cells = ivec3(s.x > 0 ? 16 - lp.x : lp.x + 1, s.y > 0 ? 16 - lp.y : lp.y + 1, s.z > 0 ? 16 - lp.z : lp.z + 1);
    vec3 tE = sd + vec3(cells - ivec3(1)) * dd;
    float m = min(tE.x, min(tE.y, tE.z));
    int side = (tE.x == m) ? 0 : (tE.y == m ? 1 : 2);
    if (side == 0) { sd.x = tE.x + dd.x; mp.x += s.x * cells.x; }
    else if (side == 1) { sd.y = tE.y + dd.y; mp.y += s.y * cells.y; }
    else { sd.z = tE.z + dd.z; mp.z += s.z * cells.z; }
    return side;
}

// Solid bit is packed as bit 31 of the voxel value in chunkPool
// Eliminates the separate bitmask SSBO read
bool isBitSolid(uint slot, ivec3 p) {
    int bi = (p.x & 15) | ((p.y & 15) << 4) | ((p.z & 15) << 8);
    uint raw = voxelPool[(slot << 12) | bi];
    return (raw >> 31) != 0u;
}

// Sample chunk-level directional SDF (in voxel units) for a chunk slot.
// dirIdx: 0=+X, 1=-X, 2=+Y, 3=-Y, 4=+Z, 5=-Z.
// Layout: 2 packed uints per slot (8 bytes).
//   uint 0 low 8 = +X, next 8 = -X, next 8 = +Y, top 8 = -Y
//   uint 1 low 8 = +Z, next 8 = -Z (top 16 unused)
// Only valid for empty-loaded chunks (slot != EMPTY and chunk has zero solids).
// Returns 0 (= no directional SDF available) for chunks with any solid; the
// caller falls back to per-voxel DDA for those.
float getChunkDirSDF(uint slot, uint dirIdx) {
    uint pack0 = sdfPool[slot << 1u];
    uint pack1 = sdfPool[(slot << 1u) | 1u];
    uint raw;
    if (dirIdx == 0u)      raw = pack0 & 0xFFu;          // +X
    else if (dirIdx == 1u) raw = (pack0 >> 8u)  & 0xFFu;  // -X
    else if (dirIdx == 2u) raw = (pack0 >> 16u) & 0xFFu;  // +Y
    else if (dirIdx == 3u) raw = (pack0 >> 24u) & 0xFFu;  // -Y
    else if (dirIdx == 4u) raw = pack1 & 0xFFu;           // +Z
    else                   raw = (pack1 >> 8u)  & 0xFFu;  // -Z
    return float(raw) / 8.0; // 0 = no SDF, max 16 voxels (= 31.875 encoded)
}

uint getVoxelOcclusion(ivec3 p) {
    ivec3 relChunk = p >> 4;
    // Single fused bounds test: min(x, 127-x) < 0 iff x < 0 || x >= 128
    if (any(lessThan(min(relChunk, ivec3(127) - relChunk), ivec3(0)))) return 0x3FFFu;
    uint slot = chunkSlots[relChunk.x | (relChunk.y << 7) | (relChunk.z << 14)];
    if (slot == EMPTY) return 0x3FFFu;
    int voxelIdx = (p.x & 15) | ((p.y & 15) << 4) | ((p.z & 15) << 8);
    uint uintIdx = (slot << 11u) | uint(voxelIdx >> 1);
    uint packedv = occlusionPool[uintIdx];
    return (voxelIdx & 1) == 0 ? (packedv & 0xFFFFu) : (packedv >> 16);
}

// True when the voxel at buffer-relative p is liquid water (not lava). Uses the
// block-data LIQUID effect tag, so it covers every water id (15, flowing 150-164).
bool isWaterVoxel(vec3 p) {
    ivec3 rel = ivec3(floor(p));
    if (any(lessThan(min(rel, ivec3(WORLD_SIZE) - 1 - rel), ivec3(0)))) return false;
    uint slot = chunkSlots[(rel.x >> 4) | ((rel.y >> 4) << 7) | ((rel.z >> 4) << 14)];
    if (slot == EMPTY) return false;
    int bi = (rel.x & 15) | ((rel.y & 15) << 4) | ((rel.z & 15) << 8);
    uint v = voxelPool[(slot << 12) | bi] & 0xFFFFu;
    if (v == 0u) return false;
    ivec4 d1 = texelFetch(u_BlockData, int(v) * 4 + 1);
    int eff = (d1.w >> 10) & 0xF;
    return eff == 2 && v != 21u;
}

// ── Ambient Occlusion ──
// Checks if a world-space voxel contains any solid geometry (contributes to occlusion).
bool isBlockSolidAO(ivec3 p) {
    ivec3 rel = p;
    if (any(lessThan(min(rel, ivec3(WORLD_SIZE) - 1 - rel), ivec3(0)))) return false;
    uint slot = chunkSlots[(rel.x >> 4) | ((rel.y >> 4) << 7) | ((rel.z >> 4) << 14)];
    if (slot == EMPTY) return false;
    return isBitSolid(slot, rel);
}

// Vertex-based ambient occlusion (cartoon).
// The classic 12-sample vertex pattern shares side/corner blocks between the 4
// vertices, so the UNIQUE set is 8 blocks (4 side + 4 corner) — sampling those
// directly removes 4 redundant SSBO indirections per AO. Vertex values stay
// identical to the classic formula, then the result is quantized to 3 cel tones
// for the flat, chunky toon shadow look.
float computeAmbientOcclusion(vec3 hp, vec3 n) {
    ivec3 blockPos = ivec3(floor(hp - n * 0.5));
    vec3 fracPos = hp - vec3(blockPos);
    ivec3 ns = ivec3(round(n)); // normal step: (0,±1,0) for Y faces, etc.

    // Face-local coordinates (u, v) and the unique neighbor blocks
    float u, v;
    ivec3 s1, s2, s3, s4; // 4 side neighbors (u/v axis-aligned)
    ivec3 c1, c2, c3, c4; // 4 corner neighbors

    if (abs(n.y) > 0.5) {
        // Top/Bottom face: u=x, v=z. Check blocks at Y+ns.y level.
        u = fracPos.x; v = fracPos.z;
        s1 = blockPos + ivec3(-1, ns.y, 0);  s2 = blockPos + ivec3(1, ns.y, 0);
        s3 = blockPos + ivec3(0, ns.y, -1);  s4 = blockPos + ivec3(0, ns.y, 1);
        c1 = blockPos + ivec3(-1, ns.y, -1); c2 = blockPos + ivec3(1, ns.y, -1);
        c3 = blockPos + ivec3(-1, ns.y, 1);  c4 = blockPos + ivec3(1, ns.y, 1);
    } else if (abs(n.x) > 0.5) {
        // East/West face: u=z, v=y. Check blocks at X+ns.x level.
        u = fracPos.z; v = fracPos.y;
        s1 = blockPos + ivec3(ns.x, 0, -1);  s2 = blockPos + ivec3(ns.x, 0, 1);
        s3 = blockPos + ivec3(ns.x, -1, 0);  s4 = blockPos + ivec3(ns.x, 1, 0);
        c1 = blockPos + ivec3(ns.x, -1, -1); c2 = blockPos + ivec3(ns.x, -1, 1);
        c3 = blockPos + ivec3(ns.x, 1, -1);  c4 = blockPos + ivec3(ns.x, 1, 1);
    } else {
        // North/South face: u=x, v=y. Check blocks at Z+ns.z level.
        u = fracPos.x; v = fracPos.y;
        s1 = blockPos + ivec3(-1, 0, ns.z);  s2 = blockPos + ivec3(1, 0, ns.z);
        s3 = blockPos + ivec3(0, -1, ns.z);  s4 = blockPos + ivec3(0, 1, ns.z);
        c1 = blockPos + ivec3(-1, -1, ns.z); c2 = blockPos + ivec3(1, -1, ns.z);
        c3 = blockPos + ivec3(-1, 1, ns.z);  c4 = blockPos + ivec3(1, 1, ns.z);
    }

    float s1f = float(isBlockSolidAO(s1)), s2f = float(isBlockSolidAO(s2));
    float s3f = float(isBlockSolidAO(s3)), s4f = float(isBlockSolidAO(s4));
    float c1f = float(isBlockSolidAO(c1)), c2f = float(isBlockSolidAO(c2));
    float c3f = float(isBlockSolidAO(c3)), c4f = float(isBlockSolidAO(c4));

    // Per-vertex occlusion (identical math to the classic 12-sample pattern:
    // each vertex sums its 2 side + 1 corner neighbor, 1/3 reduction per solid)
    float ao00 = 1.0 - (s1f + s3f + c1f) / 3.0;
    float ao10 = 1.0 - (s2f + s3f + c2f) / 3.0;
    float ao01 = 1.0 - (s1f + s4f + c3f) / 3.0;
    float ao11 = 1.0 - (s2f + s4f + c4f) / 3.0;

    // Bilinear interpolation across the face, then quantize to 3 cel tones
    // (soft transitions — hard steps read as "deep-fried" bands on slopes)
    float ao = mix(mix(ao00, ao10, u), mix(ao01, ao11, u), v);
    ao = clamp(ao, 0.2, 1.0);
    float aoBand = mix(0.35, 0.66, smoothstep(0.5, 0.62, ao));
    return mix(aoBand, 1.0, smoothstep(0.8, 0.9, ao));
}

// Sample RGB lightmap at world position.
// Returns vec4 where x = skyLight (0-255), yzw = blockLight RGB (0-255 each)
// Returns vec4(-1) if outside buffer.
vec4 sampleLightmap(ivec3 p) {
    ivec3 rel = p;
    if (any(lessThan(min(rel, ivec3(2047) - rel), ivec3(0)))) return vec4(-1);
    uint slot = chunkSlots[(rel.x >> 4) | ((rel.y >> 4) << 7) | ((rel.z >> 4) << 14)];
    if (slot == EMPTY) return vec4(-1);
    int voxelIdx = (rel.x & 15) | ((rel.y & 15) << 4) | ((rel.z & 15) << 8);
    uint idx = (slot << 12u) | uint(voxelIdx);
    uint packedv = lightPool[idx];
    // bits 0-7 = sky light, bits 8-15 = block R, bits 16-23 = block G, bits 24-31 = block B
    float sky = float(packedv & 0xFFu);
    float blockR = float((packedv >> 8u) & 0xFFu);
    float blockG = float((packedv >> 16u) & 0xFFu);
    float blockB = float((packedv >> 24u) & 0xFFu);
    return vec4(sky, blockR, blockG, blockB);
}

float fastShadow(vec3 ro, vec3 rd, float maxDist) {
    ivec3 bufMin = ivec3(0);
    ivec3 bufMax = ivec3(WORLD_SIZE);
    float tn, tf; if (!intersectAABB(ro, rd, vec3(bufMin), vec3(bufMax), tn, tf)) return 1.0;
    vec3 p = ro + rd * (max(0.0, tn) + 0.05); ivec3 mp = ivec3(floor(p));
    vec3 dd = abs(1.0 / rd); ivec3 s = ivec3(sign(rd));
    vec3 sd = (s * (vec3(mp) - p) + (s * 0.5) + 0.5) * dd;
    for (int i = 0; i < 16; i++) {  // reduced from 32 → 16
        if (any(lessThan(mp, ivec3(0))) || any(greaterThanEqual(mp, ivec3(WORLD_SIZE)))) break;
        if (min(sd.x, min(sd.y, sd.z)) > maxDist) break;
        ivec3 rel = mp;
        uint slot = chunkSlots[(rel.x >> 4) | ((rel.y >> 4) << 7) | ((rel.z >> 4) << 14)];
        if (slot == EMPTY) { skipChunk(mp, sd, dd, s); }
        else {
            if (isBitSolid(slot, mp)) {
                int bi = (mp.x&15)|((mp.y&15)<<4)|((mp.z&15)<<8);
                uint rawVoxel = voxelPool[(slot << 12) | bi];
                uint v = rawVoxel & 0xFFFFu;
                ivec4 d1 = texelFetch(u_BlockData, int(v) * 4 + 1);
                if (((d1.w >> 9) & 1) == 1) return 0.0; // Full block occludes
                // Non-full block: check AABBs
                ivec4 info = texelFetch(u_BlockAABBInfo, int(v));
                int aabbCount = info.y;
                if (aabbCount > 0) {
                    int aabbOffset = info.x;
                    vec3 blockOrigin = floor(vec3(mp));
                    float exitT = min(sd.x, min(sd.y, sd.z));
                    for (int k = 0; k < min(aabbCount, 8); k++) {
                        vec3 bMin = texelFetch(u_BlockAABBs, aabbOffset + k * 2).xyz + blockOrigin;
                        vec3 bMax = texelFetch(u_BlockAABBs, aabbOffset + k * 2 + 1).xyz + blockOrigin;
                        float aTn, aTf;
                        if (intersectAABB(ro, rd, bMin, bMax, aTn, aTf)) {
                            if (aTn < exitT) return 0.0; // AABB occludes
                        }
                    }
                }
            }
            advanceDDA(mp, sd, dd, s);
        }
    }
    return 1.0;
}

// Kinetic block IDs (shafts 291-293, cogwheel 294, large cogwheel 295, water wheel 296,
// clutch 353/354, gearshift 355/356). Their animated textures are gated by the per-voxel
// kinetic flags set by the KineticManager. Create machines with spinning animation
// strips (windmill sail 406, millstone 408, crushing wheel 409, drill 410, saw 411,
// belt 413) animate the same way when their network is powered.
bool isKineticBlock(int id) {
    return (id >= 291 && id <= 296) || (id >= 422 && id <= 437)
        || id == 353 || id == 354 || id == 355 || id == 356
        || id == 406 || (id >= 408 && id <= 411) || id == 413;
}

// Raw packed voxel at a world position (0 when out of bounds or unloaded).
uint worldRawVoxel(ivec3 p) {
    if (any(lessThan(min(p, ivec3(WORLD_SIZE) - 1 - p), ivec3(0)))) return 0u;
    uint slot = chunkSlots[(p.x >> 4) | ((p.y >> 4) << 7) | ((p.z >> 4) << 14)];
    if (slot == EMPTY) return 0u;
    int bi = (p.x & 15) | ((p.y & 15) << 4) | ((p.z & 15) << 8);
    return voxelPool[(slot << 12) | bi];
}

// Texture index for a block face (0=down,1=up,2=north,3=south,4=west,5=east).
int faceTex(int face, ivec4 d0, ivec4 d1) {
    if (face == 0) return d0.x;
    if (face == 1) return d0.y;
    if (face == 2) return d0.z;
    if (face == 3) return d0.w;
    if (face == 4) return d1.x;
    return d1.y;
}

// Gear prism descriptors for the kinetic blocks (shafts 291-293, cogwheel 294,
// large cogwheel 295, water wheel 296) plus the multiblock part blocks
// (large cogwheel 422-429, water wheel 430-437). axis: 0=X,1=Y,2=Z; radius and
// halfThick are in block units (1 block = 1.0). The cross-section is a regular
// convex `sides`-gon extruded along the axis: shafts are 4-sided (square, 4x4
// pixels) and gears are 16-sided; the gear teeth and spokes are drawn by the
// block textures (cogwheel/large_cogwheel/wheel), not by geometry.
//
// centerOff is the voxel offset from the OWNING cell to the gear's true center
// (nonzero only for multiblock parts). Every block of a multiblock renders the
// same full gear prism but clipped to its own cell (done by the caller's
// `gT < cellExitT` test), so the 3x3 footprint stitches into one big gear and
// each part block shows its slice.
// Facing -> gear spin-axis. Gears reuse the per-voxel facing bits (16-18) that
// directional Create machines use: the facing is the direction the axle points.
//   0/1 (down/up)      -> axis Y (horizontal disc)
//   2/3 (north/south)  -> axis Z (vertical disc in the XY plane)
//   4/5 (west/east)    -> axis X (vertical disc in the ZY plane)
int axisFromFacing(int facing) {
    if (facing == 0 || facing == 1) return 1;
    if (facing == 2 || facing == 3) return 2;
    return 0; // 4/5 (and any out-of-range default) -> X
}

// Canonical disc-plane offset (du, dv) -> world-space offset for a gear whose
// spin axis is `axis`. u/v are the two cross-section axes.
//   axis Y: (x,z) = (du, dv)   axis X: (z,y) = (du, dv)   axis Z: (x,y) = (du, dv)
ivec3 localToWorld(int du, int dv, int axis) {
    if (axis == 1) return ivec3(du, 0, dv);
    if (axis == 0) return ivec3(0, dv, du);
    return ivec3(du, dv, 0);
}

// Remap a world-space face index to the canonical model face of a gear whose
// model JSON is laid out for `modelAxis` (flat "face" texture on the faces
// perpendicular to modelAxis, rim on the rest). Identity when axis == modelAxis.
// The orientable gears (cog/large cog/water wheel) are all canonical axis Y, so
// the two rotations below map an X/Z-oriented gear's faces back onto the Y model.
int remapGearFace(int face, int axis, int modelAxis) {
    if (axis == modelAxis) return face;
    if (modelAxis == 1) {
        if (axis == 0) { // actual X -> canonical Y (90 deg about Z)
            if (face == 0) return 5;
            if (face == 1) return 4;
            if (face == 4) return 0;
            if (face == 5) return 1;
            return face; // 2, 3 unchanged
        } else { // actual Z -> canonical Y (-90 deg about X)
            if (face == 0) return 3;
            if (face == 1) return 2;
            if (face == 2) return 0;
            if (face == 3) return 1;
            return face; // 4, 5 unchanged
        }
    }
    return face;
}

// Kept in sync with the Java mirror in KineticManager.gearDescriptor.
bool getGear(int id, int facing, out ivec3 centerOff, out int axis, out int modelAxis, out float radius, out int sides, out float halfThick) {
    const float P = 1.0 / 16.0;
    centerOff = ivec3(0);
    modelAxis = 1; // orientable gears + their parts use the horizontal (axis-Y) model
    if (id == 291) { axis = 1; modelAxis = 1; radius = 2.0*P; sides = 4; halfThick = 8.0*P; return true; } // shaft Y (square 4x4x16)
    if (id == 292) { axis = 0; modelAxis = 0; radius = 2.0*P; sides = 4; halfThick = 8.0*P; return true; } // shaft X (square 4x4x16)
    if (id == 293) { axis = 2; modelAxis = 2; radius = 2.0*P; sides = 4; halfThick = 8.0*P; return true; } // shaft Z (square 4x4x16)
    if (id == 294) { axis = axisFromFacing(facing); radius = 8.0*P; sides = 16; halfThick = 3.0*P; return true; } // cogwheel (full block)
    if (id == 295) { axis = axisFromFacing(facing); radius = 24.0*P; sides = 16; halfThick = 3.0*P; return true; } // large cogwheel (3x1x3)
    if (id == 296) { axis = axisFromFacing(facing); if (axis == 1) axis = 2; radius = 24.0*P; sides = 16; halfThick = 4.0*P; return true; } // water wheel (vertical disc)
    // Large cogwheel multiblock parts (422-429): canonical (du,dv) offset in the
    // disc plane; centerOff = -localToWorld(du,dv,axis).
    if (id >= 422 && id <= 429) {
        axis = axisFromFacing(facing); radius = 24.0*P; sides = 16; halfThick = 3.0*P;
        int du, dv;
        if (id == 422)      { du =  0; dv = -1; } // N  (z-1)
        else if (id == 423) { du =  0; dv =  1; } // S  (z+1)
        else if (id == 424) { du = -1; dv =  0; } // W  (x-1)
        else if (id == 425) { du =  1; dv =  0; } // E  (x+1)
        else if (id == 426) { du = -1; dv = -1; } // NW (x-1,z-1)
        else if (id == 427) { du =  1; dv = -1; } // NE (x+1,z-1)
        else if (id == 428) { du = -1; dv =  1; } // SW (x-1,z+1)
        else                { du =  1; dv =  1; } // SE (x+1,z+1)
        centerOff = -localToWorld(du, dv, axis);
        return true;
    }
    // Water wheel multiblock parts (430-437): canonical (du,dv) = (x,y) offset.
    if (id >= 430 && id <= 437) {
        axis = axisFromFacing(facing); if (axis == 1) axis = 2; radius = 24.0*P; sides = 16; halfThick = 4.0*P;
        int du, dv;
        if (id == 430)      { du =  0; dv =  1; } // up    (y+1)
        else if (id == 431) { du =  0; dv = -1; } // down  (y-1)
        else if (id == 432) { du = -1; dv =  0; } // left  (x-1)
        else if (id == 433) { du =  1; dv =  0; } // right (x+1)
        else if (id == 434) { du = -1; dv =  1; } // up-left   (x-1,y+1)
        else if (id == 435) { du =  1; dv =  1; } // up-right  (x+1,y+1)
        else if (id == 436) { du = -1; dv = -1; } // down-left (x-1,y-1)
        else                { du =  1; dv = -1; } // down-right (x+1,y-1)
        centerOff = -localToWorld(du, dv, axis);
        return true;
    }
    return false;
}

// Whether a block carries a coaxial shaft through its hub. Only the center
// blocks of the cogs/wheels do (294/295/296); the multiblock rim/spoke parts
// (422-437) don't, so the shaft pokes out of the gear's center faces only.
bool getShaftThrough(int id) {
    return id == 294 || id == 295 || id == 296;
}

// Ray vs a convex N-sided prism (gear) extruded along a world axis.
// axis: 0=X, 1=Y, 2=Z. The cross-section is a regular `sides`-gon of the given
// radius. Returns the entry distance and surface normal.
bool intersectGear(vec3 ro, vec3 rd, vec3 center, int axis, float radius, int sides, float halfThick, float spinAng, out float hitT, out vec3 hitNormal) {
    float ca, oa, da;
    vec2 o, d, c;
    if (axis == 0)      { ca = center.x; oa = ro.x; da = rd.x; c = center.yz; o = ro.yz; d = rd.yz; }
    else if (axis == 1) { ca = center.y; oa = ro.y; da = rd.y; c = center.xz; o = ro.xz; d = rd.xz; }
    else                { ca = center.z; oa = ro.z; da = rd.z; c = center.xy; o = ro.xy; d = rd.xy; }

    float tNearA = -1e30, tFarA = 1e30;
    if (abs(da) > 1e-6) {
        float t1 = (ca - halfThick - oa) / da;
        float t2 = (ca + halfThick - oa) / da;
        tNearA = min(t1, t2);
        tFarA = max(t1, t2);
    } else if (oa < ca - halfThick || oa > ca + halfThick) {
        return false;
    }

    float tEnter = -1e30, tExit = 1e30;
    vec2 enterN = vec2(1.0, 0.0);
    // π/4 offset turns a 4-gon into an axis-aligned square (shafts), so the four
    // flat faces align with the world axes instead of reading as a diamond. The
    // whole cross-section also rotates by `spinAng` so a spinning square shaft's
    // corners sweep in step with its (keyway) texture, and 16-gons track the
    // gear's phase too (they're near-invariant, so it's a no-op visually there).
    float rot = (sides == 4) ? (0.78539816 + spinAng) : spinAng;
    for (int i = 0; i < sides; i++) {
        float a0 = rot + float(i) * 6.2831853 / float(sides);
        float a1 = rot + float(i + 1) * 6.2831853 / float(sides);
        vec2 p0 = c + vec2(cos(a0), sin(a0)) * radius;
        vec2 p1 = c + vec2(cos(a1), sin(a1)) * radius;
        vec2 edge = p1 - p0;
        vec2 nrm = normalize(vec2(edge.y, -edge.x));
        if (dot(nrm, (p0 + p1) * 0.5 - c) < 0.0) nrm = -nrm;
        float planeDist = dot(nrm, p0);
        float denom = dot(nrm, d);
        float rhs = planeDist - dot(nrm, o);
        if (abs(denom) < 1e-7) {
            if (rhs < 0.0) return false;
            continue;
        }
        // denom > 0: ray is leaving this half-plane (t <= tE) -> exit bound.
        // denom < 0: ray is entering it (t >= tE) -> entry bound.
        float tE = rhs / denom;
        if (denom > 0.0) {
            if (tE < tExit) tExit = tE;
        } else {
            if (tE > tEnter) { tEnter = tE; enterN = nrm; }
        }
    }
    if (tEnter > tExit) return false;

    float t0 = max(tEnter, tNearA);
    float t1 = min(tExit, tFarA);
    if (t0 > t1) return false;

    if (tNearA > tEnter) {
        hitNormal = vec3(0.0);
        hitNormal[axis] = (da > 0.0) ? -1.0 : 1.0;
    } else {
        if (axis == 0)      hitNormal = vec3(0.0, enterN.x, enterN.y);
        else if (axis == 1) hitNormal = vec3(enterN.x, 0.0, enterN.y);
        else                hitNormal = vec3(enterN.x, enterN.y, 0.0);
    }
    hitT = t0;
    return true;
}

// ── Detailed gear geometry: teeth, rim paddles and a raised hub ──
// The cogs/wheel are no longer a plain disc — they are a union of the body
// disc (rendered by intersectGear), radial "box" pieces (teeth for the cogs,
// paddle boards for the water wheel) and, for the wheel, a raised hub. Each
// box is raycast exactly (no raymarch) in the disc plane and extruded along
// the spin axis. `ang` is the box's polar angle in the gear's local frame
// (0 = +u); the caller bakes the spin phase into it.

// Disc-plane extraction + normal mapping (matches intersectGear's convention).
void gearPlane(vec3 ro, vec3 rd, vec3 c, int axis, out vec2 o, out vec2 d,
               out float oa, out float da, out float ca) {
    if (axis == 0)      { o = ro.yz; d = rd.yz; oa = ro.x; da = rd.x; ca = c.x; }
    else if (axis == 1) { o = ro.xz; d = rd.xz; oa = ro.y; da = rd.y; ca = c.y; }
    else                { o = ro.xy; d = rd.xy; oa = ro.z; da = rd.z; ca = c.z; }
}
vec3 discToWorld(vec2 n, int axis) {
    if (axis == 0) return vec3(0.0, n.x, n.y);
    if (axis == 1) return vec3(n.x, 0.0, n.y);
    return vec3(n.x, n.y, 0.0);
}
vec3 axisUnit(int axis) {
    if (axis == 0) return vec3(1.0, 0.0, 0.0);
    if (axis == 1) return vec3(0.0, 1.0, 0.0);
    return vec3(0.0, 0.0, 1.0);
}

// Radial box (tooth/paddle) at polar angle `ang`: radial extent [r0, r1],
// tangential half-width `halfW`, extruded along the axis by `halfThick`.
// Returns the entry t and the disc-plane entry normal; axisFace is true when
// the entry face is one of the two flat faces perpendicular to the axis.
bool gearBox(vec2 o, vec2 d, float ang, float r0, float r1, float halfW,
             float oa, float da, float ca, float halfThick,
             out float tOut, out vec2 nOut, out bool axisFace) {
    float cs = cos(ang), sn = sin(ang);
    vec2 ob = vec2(o.x * cs + o.y * sn, -o.x * sn + o.y * cs);
    vec2 db = vec2(d.x * cs + d.y * sn, -d.x * sn + d.y * cs);
    float tUin = -1e30, tUout = 1e30;
    if (abs(db.x) > 1e-7) {
        float t0 = (r0 - ob.x) / db.x, t1 = (r1 - ob.x) / db.x;
        tUin = min(t0, t1); tUout = max(t0, t1);
    } else if (ob.x < r0 || ob.x > r1) return false;
    float tVin = -1e30, tVout = 1e30;
    if (abs(db.y) > 1e-7) {
        float t0 = (-halfW - ob.y) / db.y, t1 = (halfW - ob.y) / db.y;
        tVin = min(t0, t1); tVout = max(t0, t1);
    } else if (ob.y < -halfW || ob.y > halfW) return false;
    float tAin = -1e30, tAout = 1e30;
    if (abs(da) > 1e-7) {
        float t0 = (ca - halfThick - oa) / da, t1 = (ca + halfThick - oa) / da;
        tAin = min(t0, t1); tAout = max(t0, t1);
    } else if (oa < ca - halfThick || oa > ca + halfThick) return false;
    float tIn = max(max(tUin, tVin), tAin);
    float tExit = min(min(tUout, tVout), tAout);
    if (tIn > tExit) return false;
    axisFace = (tAin >= tUin && tAin >= tVin);
    vec2 nb = vec2(0.0);
    if (!axisFace) {
        if (tUin >= tVin) nb = vec2(db.x > 0.0 ? -1.0 : 1.0, 0.0);
        else              nb = vec2(0.0, db.y > 0.0 ? -1.0 : 1.0);
    }
    nOut = vec2(nb.x * cs - nb.y * sn, nb.x * sn + nb.y * cs);
    tOut = tIn;
    return true;
}

// Union of the body disc, radial teeth/paddles and (wheel only) a raised hub.
// kind: 0 = cogwheel (294), 1 = large cogwheel (295 + parts 422-429),
//       2 = water wheel (296 + parts 430-437).
bool intersectGearDetailed(int id, vec3 ro, vec3 rd, vec3 center, int axis, float spinAng,
                           out float tOut, out vec3 nOut) {
    const float P = 1.0 / 16.0;
    int kind = -1;
    if (id == 294) kind = 0;
    else if (id == 295 || (id >= 422 && id <= 429)) kind = 1;
    else if (id == 296 || (id >= 430 && id <= 437)) kind = 2;

    float bodyR, halfThick, r0, r1, toothW; int pieces;
    if (kind == 0)      { bodyR = 0.375;  halfThick = 3.0*P; r0 = 0.375;  r1 = 0.5;  toothW = 0.0625; pieces = 8; }
    else if (kind == 1) { bodyR = 1.125;  halfThick = 3.0*P; r0 = 1.125;  r1 = 1.5;  toothW = 0.125;  pieces = 8; }
    else                { bodyR = 1.25;   halfThick = 4.0*P; r0 = 1.25;   r1 = 1.5;  toothW = 0.125;  pieces = 8; }

    vec2 o, d; float oa, da, ca;
    gearPlane(ro, rd, center, axis, o, d, oa, da, ca);
    float bestT = 1e30; vec3 bestN = vec3(0.0, 1.0, 0.0); bool any = false;

    // Body disc.
    float dT; vec3 dN;
    if (intersectGear(ro, rd, center, axis, bodyR, 16, halfThick, spinAng, dT, dN) && dT > 0.0) {
        bestT = dT; bestN = dN; any = true;
    }
    // Teeth / paddle boards.
    for (int k = 0; k < pieces; k++) {
        float ang = spinAng + float(k) * 6.2831853 / float(pieces);
        if (kind == 2) ang += 0.39269908; // 22.5° offset: paddles sit between the spokes
        float bT; vec2 bN; bool bAxis;
        if (gearBox(o, d, ang, r0, r1, toothW, oa, da, ca, halfThick, bT, bN, bAxis) && bT > 0.0 && bT < bestT) {
            bestT = bT;
            bestN = bAxis ? axisUnit(axis) * (da > 0.0 ? -1.0 : 1.0) : discToWorld(bN, axis);
            any = true;
        }
    }
    // Water wheel: raised hub boss around the shaft.
    if (kind == 2) {
        float hT; vec3 hN;
        if (intersectGear(ro, rd, center, axis, 0.25, 16, halfThick + 2.0*P, spinAng, hT, hN) && hT > 0.0 && hT < bestT) {
            bestT = hT; bestN = hN; any = true;
        }
    }
    tOut = bestT; nOut = bestN;
    return any;
}

bool traceWorld(vec3 ro, vec3 rd, bool skipFirst, ivec3 airVoxel, uint lastMediumTag, out float resT, out int resSide, out uint resVoxel, out uint resWirePower, out uint resWireConn, out int resAabbIdx, out ivec4 resBlockData1, out uint resKineticActive, out uint resKineticReverse, out uint resFacing, out vec3 resNormal, out ivec3 resGearOrigin, out int resGearShaft) {
    ivec3 bufMin = ivec3(0);
    ivec3 bufMax = ivec3(WORLD_SIZE);
    float tn, tf; if (!intersectAABB(ro, rd, vec3(bufMin), vec3(bufMax), tn, tf)) return false;
    float st = max(0.0, tn); vec3 p = ro + rd * st; ivec3 mp = ivec3(floor(p));
    vec3 dd = abs(1.0 / rd); ivec3 s = ivec3(sign(rd));
    vec3 sd = (s * (vec3(mp) - p) + (s * 0.5) + 0.5) * dd;
    int side = 0; if (skipFirst) side = advanceDDA(mp, sd, dd, s);
    resBlockData1 = ivec4(0); // block-data d1 threaded to the caller (avoids a redundant texelFetch in main)
    resKineticActive = 0u; resKineticReverse = 0u; resFacing = 1u; resNormal = vec3(0.0, 1.0, 0.0); resGearOrigin = ivec3(0); resGearShaft = 0;
    // Per-chunk SDF sphere-trace step is gated at SDF>1.5; when close to surface
    // (SDF<=1.5) or crossing a chunk boundary, fallback to per-voxel DDA.
    for (int i = 0; i < 256; i++) {  // bumped from 72: sphere-trace skips chunks fast
        if (any(lessThan(mp, bufMin)) || any(greaterThanEqual(mp, bufMax))) break;
        if (st > tf) break;
        ivec3 rel = mp;
        uint slot = chunkSlots[(rel.x >> 4) | ((rel.y >> 4) << 7) | ((rel.z >> 4) << 14)];
        if (slot == EMPTY) {
            // Empty chunk: skip whole 16³ section in one DDA step (peer over chunks)
            // ── Map preview: a downward map ray over an unloaded column samples the
            //    CPU biome preview here (the FIRST EMPTY chunk the ray enters is the
            //    column this pixel points at). Beyond the world border the preview is
            //    void, so the map stops exactly at the world size. The flag only
            //    matters if the ray ultimately misses — a loaded chunk below the
            //    empty section still renders as real terrain.
            if (u_MapMode == 1 && rd.y < 0.0) {
                // Sample the preview at the XZ where this ray lands on the map's
                // ground plane (world sea level), not at the EMPTY cell's own XZ.
                // Sampling the cell XZ is only correct for an orthographic camera:
                // under perspective, an off-center ray's XZ at the entry height is
                // offset from where it actually meets the ground, which skews the
                // preview. Projecting the ray to the ground plane makes the preview
                // behave like the terrain really is there.
                float tPlane = (u_MapGroundY - ro.y) / rd.y;
                // tPlane <= 0 means the ground plane is at/behind the camera
                // (e.g. minimum zoom puts the camera below sea level) — skip
                // the preview sample but let the DDA continue.
                if (tPlane > 0.0) {
                    vec2 planeXZ = ro.xz + rd.xz * tPlane;
                    vec2 worldXZ = planeXZ + u_MapWorldOrigin;
                    if (abs(worldXZ.x) <= u_MapBorder && abs(worldXZ.y) <= u_MapBorder) {
                        vec2 texCoord = (planeXZ - u_MapPreviewOrigin) * (1.0 / u_MapPreviewScale) + 0.5;
                        texCoord *= 1.0 / MAP_PREVIEW_TEXELS;
                        if (texCoord.x >= 0.0 && texCoord.x <= 1.0 && texCoord.y >= 0.0 && texCoord.y <= 1.0) {
                            vec4 prev = texture(u_MapPreview, texCoord);
                            if (prev.a > 0.5) { gMapPreviewCol = prev.rgb; gMapPreviewValid = true; }
                        }
                    }
                }
            }
            // Empty chunk: skip whole 16³ section in one DDA step (peer over chunks)
            // ── Tall-skip optimization (ray points up only): collapse many consecutive
            //    EMPTY chunks in a single traceWorld iteration. Without this, a sky-look
            //    ray at ground level iterates ~125 times (one per chunk), each calling
            //    skipChunk. With this, it iterates only when reaching the first non-EMPTY
            //    chunk above (or buffer end). Cost when rd.y<=0: none. Cost when rd.y>0
            //    but immediate next chunk above is non-EMPTY: ~5 ops (single slot read)
            //    — strictly better than skipChunk's ~30 ops for the no-skip case still.
            if (rd.y > 0.0) {
                int curChunkY = rel.y >> 4;
                int advance = 0;
                for (int k = 1; k < 128; k++) {
                    if (curChunkY + k >= 128) break;
                    uint futureSlot = chunkSlots[(rel.x >> 4) | ((curChunkY + k) << 7) | ((rel.z >> 4) << 14)];
                    if (futureSlot != EMPTY) break;
                    advance = k;
                }
                if (advance > 0) {
                    mp.y += advance * 16;
                    vec3 newP = ro + rd * st;
                    sd = (s * (vec3(mp) - newP) + (s * 0.5) + 0.5) * dd;
                    side = 1; // Y-axis crossing — last axis we leapt through
                    continue;
                }
            }
            side = skipChunk(mp, sd, dd, s);
        } else {
            // ── Chunk-level directional SDF sphere-trace acceleration ──
            // Per-direction chunk SDF says how many voxels the ray can travel
            // along that axis before crossing into a non-empty chunk or
            // chunk boundary. For empty-loaded chunks (zero solids), this
            // allows leaping up to ~16 voxels in the dominant axis direction
            // in a single iteration — collapsing ~125 outer iters of pure-sky
            // traversal into ~1.
            // (Unit note: sd.x/y/z are t-space; convert to voxels via /dd since
            // dd = 1/|rd|, so sd*/dd = sd*|rd| = voxel distance along that axis.)
            float absX = abs(rd.x), absY = abs(rd.y), absZ = abs(rd.z);
            uint domAxis;
            float domVal;
            if      (absX >= absY && absX >= absZ) { domAxis = 0u; domVal = rd.x; }
            else if (absY >= absZ)                { domAxis = 1u; domVal = rd.y; }
            else                                   { domAxis = 2u; domVal = rd.z; }
            float maxAbsRd = (domAxis == 0u) ? absX : ((domAxis == 1u) ? absY : absZ);
            uint dirIdx = domAxis * 2u + (domVal > 0.0 ? 0u : 1u);
            float chunkSdf = getChunkDirSDF(slot, dirIdx);
            if (chunkSdf > 1.5) {
                // Convert t-space dist-to-boundary to voxel units along dom axis:
                // sd.dom * |rd.dom| = sd.dom / dd.dom (since dd = 1/|rd|).
                float distToBndDomVox = (domAxis == 0u) ? sd.x / dd.x :
                                       (domAxis == 1u) ? sd.y / dd.y :
                                                          sd.z / dd.z;
                float stepVox = min(chunkSdf * 0.95, distToBndDomVox - 1.0);
                if (stepVox > 1.0) {
                    float tStep = stepVox / maxAbsRd;
                    st += tStep;
                    vec3 newP = ro + rd * st;
                    mp = ivec3(floor(newP));
                    sd = (s * (vec3(mp) - newP) + (s * 0.5) + 0.5) * dd;
                    side = int(domAxis);
                    continue;
                }
            }
            // ── Per-voxel DDA fallback (surface hit or small SDF) ──
            ivec3 cc = mp >> 4; uint maskBase = slot << 7;
            for (int j = 0; j < 32; j++) {
                int bi = (mp.x&15)|((mp.y&15)<<4)|((mp.z&15)<<8);
                // Camera-clipped voxel (eye stuck inside a solid block): treat that
                // voxel as air until the first real hit — the ray passes through it
                // and hits the next surface at its true distance, so its interior
                // faces never paint the stretched block texture across the view.
                // airVoxel is the sentinel ivec3(0x7FFFFFFF) on every other trace
                // (never matches), so only the clipped bounce-0 ray is affected.
                // Gated on camClipped (warp-coherent) so the compare costs
                // nothing on the non-clipped hot path.
                bool camAirCell = camClipped && all(equal(mp, airVoxel));
                if (!camAirCell && (bitmasks[maskBase | (bi >> 5)] & (1u << (bi & 31))) != 0) {
                    uint rawVoxel = voxelPool[(slot << 12) | bi];
                    uint voxelType = rawVoxel & 0xFFFFu;
                    uint wirePower = (rawVoxel >> 16) & 0xFu;
                    uint wireConn = (rawVoxel >> 20) & 0xFu;
                    uint facingVox = (rawVoxel >> 16) & 0x7u;
                    // Kinetic flags (bits 24-25) written by KineticManager: bit 24 = spinning,
                    // bit 25 = reversed. Consumed by the main loop to gate cog/wheel animation.
                    uint kinActive = (rawVoxel >> 24) & 1u;
                    uint kinReverse = (rawVoxel >> 25) & 1u;
                    // Compute medium tag for same-medium face culling (water=1, lava=2, others=voxelType)
                    ivec4 d1 = texelFetch(u_BlockData, int(voxelType) * 4 + 1);
                    uint thisMediumTag = voxelType;
                    int thisEff = (d1.w >> 10) & 0xF;
                    if (thisEff == 2) { thisMediumTag = (voxelType == 21u) ? 2u : 1u; }
                    if (thisMediumTag != lastMediumTag) {
                        // Non-AABB gear blocks (shafts/cogs/wheel) and multiblock
                        // gear parts. Each block renders its own slice of the gear:
                        // the prism is clipped to the owning cell (gT < cell exit),
                        // and UVs are centered on the multiblock's true center.
                        ivec3 gCenterOff; int gAxis, gModelAxis; float gOuter, gHalf; int gSides;
                        bool isGear = getGear(int(voxelType), int(facingVox), gCenterOff, gAxis, gModelAxis, gOuter, gSides, gHalf);
                        if (isGear) {
                            const float P = 1.0 / 16.0;
                            vec3 gCenter = vec3(mp + gCenterOff) + 0.5;
                            float cellExit = st + min(sd.x, min(sd.y, sd.z));
                            // Spin phase of the gear cross-section. The UV (keyway/
                            // teeth) already rotates in the main loop; the hitbox must
                            // rotate too so a square shaft's corners sweep in step with
                            // its texture instead of sitting still. d3.w bit 6 =
                            // isRotating, bits 8-23 = speed (rev/s * 256).
                            ivec4 gd3 = texelFetch(u_BlockData, int(voxelType) * 4 + 3);
                            float gearSpin = 0.0;
                            if (((gd3.w >> 6) & 1) == 1 && kinActive != 0u) {
                                float rps = float((gd3.w >> 8) & 0xFFFF) / 256.0;
                                gearSpin = fract(rps * u_Time);
                                if (kinReverse != 0u) gearSpin = 1.0 - gearSpin;
                            }
                            float spinAng = gearSpin * 6.2831853;
                            // Disc prism hit. Shafts (4-sided) keep the plain
                            // square prism; the cogs/wheel (16-sided) use the
                            // detailed teeth/paddles/hub geometry.
                            float gT; vec3 gN;
                            bool discHit = false;
                            if (gSides == 4) {
                                discHit = intersectGear(ro, rd, gCenter, gAxis, gOuter, gSides, gHalf, spinAng, gT, gN)
                                        && gT > 0.0 && gT < cellExit;
                            } else {
                                discHit = intersectGearDetailed(int(voxelType), ro, rd, gCenter, gAxis, spinAng, gT, gN)
                                        && gT > 0.0 && gT < cellExit;
                            }
                            // Coaxial 4x4x16 square shaft through the hub (cog/large
                            // cog/water wheel centers only) — pokes out both faces.
                            float sT = 0.0; vec3 sN = vec3(0.0);
                            bool shaftHit = getShaftThrough(int(voxelType))
                                        && intersectGear(ro, rd, gCenter, gAxis, 2.0*P, 4, 8.0*P, spinAng, sT, sN)
                                        && sT > 0.0 && sT < cellExit;
                            if (discHit || shaftHit) {
                                if (shaftHit && (!discHit || sT <= gT)) { gT = sT; gN = sN; resGearShaft = 1; }
                                else resGearShaft = 0;
                                resVoxel = voxelType;
                                resWirePower = wirePower;
                                resWireConn = wireConn;
                                resKineticActive = kinActive;
                                resKineticReverse = kinReverse;
                                resFacing = facingVox;
                                resT = gT;
                                resAabbIdx = -1;
                                resBlockData1 = d1;
                                resNormal = gN;
                                resGearOrigin = mp + gCenterOff;
                                return true;
                            }
                        }
                        // Gears (and their multiblock parts) render exclusively via the
                        // prism — no AABB/full-block fallback, so a part never shows its
                        // slab model outside the round gear silhouette.
                        if (!isGear && ((d1.w >> 9) & 1) == 1) {
                            resVoxel = voxelType;
                            resWirePower = wirePower;
                            resWireConn = wireConn;
                            resKineticActive = kinActive;
                            resKineticReverse = kinReverse;
                            resFacing = facingVox;
                            resSide = side;
                            resT = (side == 0 ? sd.x - dd.x : (side == 1 ? sd.y - dd.y : sd.z - dd.z)) + st;
                            resAabbIdx = -1;
                            resBlockData1 = d1;
                            return true;
                        }
                        if (!isGear) {
                        ivec4 info = texelFetch(u_BlockAABBInfo, int(voxelType));
                        int aabbOffset = info.x;
                        int aabbCount = info.y;
                        if (aabbCount == 0) {
                            resVoxel = voxelType;
                            resWirePower = wirePower;
                            resWireConn = wireConn;
                            resKineticActive = kinActive;
                            resKineticReverse = kinReverse;
                            resFacing = facingVox;
                            resSide = side;
                            resT = (side == 0 ? sd.x - dd.x : (side == 1 ? sd.y - dd.y : sd.z - dd.z)) + st;
                            resAabbIdx = -1;
                            resBlockData1 = d1;
                            return true;
                        }
                        float exitT = st + min(sd.x, min(sd.y, sd.z));
                        vec3 blockOrigin = floor(vec3(mp));
                        for (int k = 0; k < min(aabbCount, 6); k++) {
                            vec3 bMin = texelFetch(u_BlockAABBs, aabbOffset + k * 2).xyz + blockOrigin;
                            vec3 bMax = texelFetch(u_BlockAABBs, aabbOffset + k * 2 + 1).xyz + blockOrigin;
                            float aTn, aTf;
                            if (intersectAABB(ro, rd, bMin, bMax, aTn, aTf)) {
                                if (aTn < exitT) {
                                    resVoxel = voxelType;
                                    resWirePower = wirePower;
                                    resWireConn = wireConn;
                                    resKineticActive = kinActive;
                                    resKineticReverse = kinReverse;
                                    resFacing = facingVox;
                                    resT = aTn;
                                    resAabbIdx = (aabbOffset / 2) + k;
                                    resBlockData1 = d1;
                                    vec3 hp = ro + rd * aTn;
                                    vec3 center = (bMin + bMax) * 0.5;
                                    vec3 halfSize = (bMax - bMin) * 0.5;
                                    vec3 localP = abs((hp - center) / max(halfSize, vec3(0.0001)));
                                    if (localP.x >= localP.y && localP.x >= localP.z) resSide = 0;
                                    else if (localP.y >= localP.z) resSide = 1;
                                    else resSide = 2;
                                    return true;
                                }
                            }
                        }
                        }
                    }
                }
                side = advanceDDA(mp, sd, dd, s);
                if (any(notEqual(mp >> 4, cc))) break;
            }
        }
        if (st + min(sd.x, min(sd.y, sd.z)) > tf) break;
    }
    return false;
}

bool traceAll(vec3 ro, vec3 rd, bool skipFirst, ivec3 airVoxel, uint lastMediumTag, out float resT, out vec3 resN, out uint resVoxel, out uint resTex, out vec2 resEntUv, out bool isEnt, out bool isHpBar, out float hpRatio, out uint resWirePower, out uint resWireConn, out int resAabbIdx, out int resEntIdx, out float resEntEmissive, out int resCraftingIdx, out ivec4 resBlockData1, out uint resKineticActive, out uint resKineticReverse, out uint resFacing, out ivec3 resGearOrigin, out int resGearShaft) {
    resT = 1e30; resEntUv = vec2(0.5); isEnt = false; isHpBar = false; hpRatio = 1.0; resWirePower = 0u; resWireConn = 0u; resAabbIdx = -1; resEntIdx = -1; resEntEmissive = 0.0; resCraftingIdx = -1; resBlockData1 = ivec4(0); resKineticActive = 0u; resKineticReverse = 0u; resFacing = 1u; resGearOrigin = ivec3(0); resGearShaft = 0;
    float tV; int sideV; uint voxelV, wirePowerV, wireConnV, kinActiveV, kinReverseV, facingV; int aabbIdxV; vec3 normalV; ivec3 gearOriginV; int gearShaftV;
    if (traceWorld(ro, rd, skipFirst, airVoxel, lastMediumTag, tV, sideV, voxelV, wirePowerV, wireConnV, aabbIdxV, resBlockData1, kinActiveV, kinReverseV, facingV, normalV, gearOriginV, gearShaftV)) {
        resT = tV; resVoxel = voxelV;
        resWirePower = wirePowerV;
        resWireConn = wireConnV;
        resKineticActive = kinActiveV;
        resKineticReverse = kinReverseV;
        resFacing = facingV;
        resAabbIdx = aabbIdxV;
        resGearOrigin = gearOriginV;
        resGearShaft = gearShaftV;
        resN = ((voxelV >= 291u && voxelV <= 296u) || (voxelV >= 422u && voxelV <= 437u))
            ? normalV
            : (sideV == 0) ? vec3(-sign(rd.x), 0, 0) : ((sideV == 1) ? vec3(0, -sign(rd.y), 0) : vec3(0, 0, -sign(rd.z)));
    }
    // Early cull: skip entities far from the ray origin or behind the camera
    vec3 roToEnt;
    float entDistSq;
    for(int i=0; i<u_EntityCount; i++) {
        // Read only the position first: culled entities (most of them at >32
        // blocks) never pay for the rest of the struct's SSBO traffic.
        vec3 entPos = entities[i].position;
        roToEnt = entPos - ro;
        entDistSq = dot(roToEnt, roToEnt);
        // Skip entities > 32 blocks away (tight cull; CPU pre-filters <= 64 blocks)
        if (entDistSq > 1024.0) continue;
        // Skip entities behind the camera and more than 16 blocks away
        if (dot(roToEnt, rd) < 0.0 && entDistSq > 256.0) continue;

        EntityData ent = entities[i];
        mat3 entRotation = rotationMatrix(ent.rotation);

        // Health Bar Check (Billboarded)
        if (ent.maxHealth > 0.001 && ent.health > 0.0) {
            vec3 barPos = entPos + vec3(0, 2.3, 0); // Above entity
            vec3 toCam = normalize(camPos - barPos);
            vec3 right = normalize(cross(vec3(0,1,0), toCam));
            vec3 up = cross(toCam, right);
            mat3 barRot = mat3(right, up, toCam);
            
            float tn; vec3 pNormal, lHit, lNormal;
            if (intersectOrientedBox(ro, rd, barPos, vec3(0.5, 0.05, 0.01), barRot, tn, pNormal, lHit, lNormal)) {
                if (tn < resT) {
                    resT = tn; isEnt = true; isHpBar = true;
                    hpRatio = clamp(ent.health / ent.maxHealth, 0.0, 1.0);
                    resEntUv = (lHit.xy / vec2(0.5, 0.05)) * 0.5 + 0.5;
                    resN = pNormal;
                }
            }
        }

        for(int j=0; j<ent.partCount; j++) {
            PartData part = parts[ent.partOffset + j];
            vec3 halfSize = part.size / 32.0;
            vec3 pivot = part.absoluteOffset / 16.0;
            vec3 geomCenter = (part.offset / 16.0) + halfSize;
            
            mat3 localRot = rotationMatrix(part.rotation);
            vec3 localCenter = pivot + localRot * (geomCenter - pivot);
            
            vec3 center = entPos + entRotation * localCenter;
            mat3 partRotation = entRotation * localRot;
            float tn;
            vec3 partNormal, localHit, localNormal;
            if (intersectOrientedBox(ro, rd, center, halfSize, partRotation, tn, partNormal, localHit, localNormal)) {
                if (tn < resT) {
                    resT = tn; isEnt = true; isHpBar = false;
                    if (part.textureMapping > 1.5) {
                        // High bit marks the virtual 128px Iron Golem atlas.
                        resTex = uint(part.textureIndex) | 0x80000000u;
                        resEntUv = entityVirtualCuboidAtlasUv(localHit, localNormal, halfSize, part);
                    } else {
                        resTex = uint(part.textureIndex);
                        resEntUv = part.textureMapping > 0.5
                            ? entityCuboidAtlasUv(localHit, localNormal, halfSize, part)
                            : entityPlanarUv(localHit, localNormal, halfSize);
                    }
                    resN = partNormal;
                    resEntIdx = i;
                    resEntEmissive = part.emissive;
                }
            }
        }
    }

    // Crafting items: 3D miniature blocks using scaled block AABBs.
    // Two paths based on whether the item is spinning (blockInfo.y != 0):
    //   - Static (blockInfo.y == 0): standard AABB path. Used by the crafting-grid entries.
    //   - Spinning (blockInfo.y != 0): OBB path using intersectOrientedBox with a Y-rotation
    //     matrix. Used by dropped items so they rotate like Minecraft-style entity items.
    float maxDroppedItemDist = 32.0; // Cheap cull: dropped items only render near the camera.
    for (int i = 0; i < u_CraftingItemCount; i++) {
        int blockId = floatBitsToInt(craftingItems[i].position.w);
        if (blockId <= 0) continue;
        vec3 pos = craftingItems[i].position.xyz;
        float scale = craftingItems[i].blockInfo.x;
        float halfScale = scale * 0.5;
        float spinAngle = craftingItems[i].blockInfo.y;

        // Cost control: spinning dropped items cost ~10-15 GPU ops per OBB test, and a full
        // crafting grid has up to 64 dropped items. Skip items outside a reasonable view
        // distance. Crafting grid items are always nearby (radius ~2 from player at table)
        // so the distance test only meaningfully affects dropped items.
        if (spinAngle != 0.0) {
            vec3 toItem = pos - ro;
            float distSq = dot(toItem, toItem);
            if (distSq > maxDroppedItemDist * maxDroppedItemDist) continue;
        }

        ivec4 info = texelFetch(u_BlockAABBInfo, blockId);
        int aabbCount = info.y;
        int aabbOffset = info.x;

        float minT = 1e30;
        vec3 hitN = vec3(0, 1, 0);
        bool hit = false;

        if (spinAngle == 0.0) {
            // Static AABB path (cheaper, used by crafting-grid items).
            if (aabbCount > 0) {
                for (int k = 0; k < min(aabbCount, 8); k++) {
                    vec3 bMin = texelFetch(u_BlockAABBs, aabbOffset + k * 2).xyz;
                    vec3 bMax = texelFetch(u_BlockAABBs, aabbOffset + k * 2 + 1).xyz;
                    vec3 scaledMin = pos + (bMin - 0.5) * scale;
                    vec3 scaledMax = pos + (bMax - 0.5) * scale;

                    float tn, tf;
                    if (intersectAABB(ro, rd, scaledMin, scaledMax, tn, tf)) {
                        float hitT = tn > 0.0 ? tn : tf;
                        if (hitT < minT) {
                            minT = hitT;
                            vec3 hp = ro + rd * hitT;
                            vec3 centerAABB = (scaledMin + scaledMax) * 0.5;
                            vec3 halfAABB = (scaledMax - scaledMin) * 0.5;
                            vec3 localP = (hp - centerAABB) / max(halfAABB, vec3(0.0001));
                            vec3 la = abs(localP);
                            if (la.x >= la.y && la.x >= la.z) hitN = vec3(sign(localP.x), 0, 0);
                            else if (la.y >= la.z) hitN = vec3(0, sign(localP.y), 0);
                            else hitN = vec3(0, 0, sign(localP.z));
                            hit = true;
                        }
                    }
                }
            } else {
                // No AABBs (e.g. water): treat as full block at item scale.
                vec3 halfSize = vec3(halfScale);
                float tn, tf;
                if (intersectAABB(ro, rd, pos - halfSize, pos + halfSize, tn, tf)) {
                    float hitT = tn > 0.0 ? tn : tf;
                    if (hitT < minT) {
                        minT = hitT;
                        vec3 localP = (ro + rd * hitT - pos) / max(halfScale, 0.0001);
                        vec3 la = abs(localP);
                        if (la.x >= la.y && la.x >= la.z) hitN = vec3(sign(localP.x), 0, 0);
                        else if (la.y >= la.z) hitN = vec3(0, sign(localP.y), 0);
                        else hitN = vec3(0, 0, sign(localP.z));
                        hit = true;
                    }
                }
            }
        } else {
            // Spinning OBB path (used by dropped items).
            // mat3 rotateY spinAngle; reused via closure by intersectOrientedBox.
            mat3 rot = rotateY(spinAngle);
            if (aabbCount > 0) {
                for (int k = 0; k < min(aabbCount, 8); k++) {
                    vec3 bMin = texelFetch(u_BlockAABBs, aabbOffset + k * 2).xyz;
                    vec3 bMax = texelFetch(u_BlockAABBs, aabbOffset + k * 2 + 1).xyz;
                    // Each sub-AABB has its own offset from the block's primary center,
                    // rotated independently so blocks like crafting tables don't deform.
                    vec3 subCenter = pos + ((bMin + bMax) * 0.5 - 0.5) * scale;
                    vec3 subHalfSize = (bMax - bMin) * 0.5 * scale;
                    float tn;
                    vec3 hitN_local, hitLocalPos, hitLocalNormal;
                    if (intersectOrientedBox(ro, rd, subCenter, subHalfSize, rot, tn, hitN_local, hitLocalPos, hitLocalNormal)) {
                        if (tn < minT) {
                            minT = tn;
                            hitN = hitN_local; // world-space normal (already rotated by intersectOrientedBox)
                            hit = true;
                        }
                    }
                }
            } else {
                // Full cube rotated. Use intersectOrientedBox with the per-axis halfSize.
                vec3 halfSizeVec = vec3(halfScale);
                float tn;
                vec3 hitN_local, hitLocalPos, hitLocalNormal;
                if (intersectOrientedBox(ro, rd, pos, halfSizeVec, rot, tn, hitN_local, hitLocalPos, hitLocalNormal)) {
                    if (tn < minT) {
                        minT = tn;
                        hitN = hitN_local;
                        hit = true;
                    }
                }
            }
        }

        if (hit && minT < resT) {
            resT = minT;
            resN = hitN;
            resCraftingIdx = i;
            isEnt = false;
        }
    }
    return resT < 1e20;
}

// Two-layer shadow helpers

// March from the pool near plane into the scene (-u_ShadowSunDir) and return the
// first occluding voxel's distance along the light axis, normalized to [0,1]
// (1.0 = nothing within the pool depth). Mirrors fastShadow's hit rules so baked
// pools match visible geometry exactly.
float poolDepth(vec3 ro) {
    vec3 rd = -u_ShadowSunDir;
    ivec3 bufMin = ivec3(0); ivec3 bufMax = ivec3(WORLD_SIZE);
    float tn, tf; if (!intersectAABB(ro, rd, vec3(bufMin), vec3(bufMax), tn, tf)) return 1.0;
    float st = max(0.0, tn);
    vec3 p = ro + rd * st; ivec3 mp = ivec3(floor(p));
    vec3 dd = abs(1.0 / rd); ivec3 s = ivec3(sign(rd));
    vec3 sd = (s * (vec3(mp) - p) + (s * 0.5) + 0.5) * dd;
    float invDepth = 1.0 / u_ShadowExtent.y;
    int side = 0; // axis of the face the ray crossed to enter the current cell
    for (int i = 0; i < 96; i++) {
        if (any(lessThan(mp, ivec3(0))) || any(greaterThanEqual(mp, ivec3(WORLD_SIZE)))) break;
        // Current cell entry distance from the ray origin = the last-stepped axis'
        // boundary (the axis returned by advanceDDA, exactly like traceWorld).
        float enter = (side == 0 ? sd.x - dd.x : (side == 1 ? sd.y - dd.y : sd.z - dd.z));
        float cellEnter = st + enter;
        if (cellEnter > u_ShadowExtent.y) break;
        ivec3 rel = mp;
        uint slot = chunkSlots[(rel.x >> 4) | ((rel.y >> 4) << 7) | ((rel.z >> 4) << 14)];
        if (slot == EMPTY) { skipChunk(mp, sd, dd, s); }
        else {
            if (isBitSolid(slot, mp)) {
                int bi = (mp.x & 15) | ((mp.y & 15) << 4) | ((mp.z & 15) << 8);
                uint rawVoxel = voxelPool[(slot << 12) | bi];
                uint v = rawVoxel & 0xFFFFu;
                ivec4 d1 = texelFetch(u_BlockData, int(v) * 4 + 1);
                if (((d1.w >> 9) & 1) == 1) return clamp(max(cellEnter, 0.0) * invDepth, 0.0, 1.0);
                ivec4 info = texelFetch(u_BlockAABBInfo, int(v));
                int aabbCount = info.y;
                if (aabbCount > 0) {
                    int aabbOffset = info.x;
                    vec3 blockOrigin = floor(vec3(mp));
                    float exitT = st + min(sd.x, min(sd.y, sd.z)); // cell exit distance
                    for (int k = 0; k < min(aabbCount, 8); k++) {
                        vec3 bMin = texelFetch(u_BlockAABBs, aabbOffset + k * 2).xyz + blockOrigin;
                        vec3 bMax = texelFetch(u_BlockAABBs, aabbOffset + k * 2 + 1).xyz + blockOrigin;
                        float aTn, aTf;
                        if (intersectAABB(ro, rd, bMin, bMax, aTn, aTf)) {
                            if (aTn < exitT) return clamp(max(aTn, 0.0) * invDepth, 0.0, 1.0);
                        }
                    }
                }
            }
        }
        side = advanceDDA(mp, sd, dd, s); // runs for BOTH branches (empty chunks too)
    }
    return 1.0;
}

// Light pool: parallel rays from the pool near plane record first-hit depth along
// the pool's light direction (Java binds the target pool texture + basis per gen).
void genLightPool() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy); ivec2 sz = imageSize(u_ShadowMapOut);
    if (any(greaterThanEqual(px, sz))) return;
    vec2 ndc = ((vec2(px) + 0.5) / vec2(sz)) * 2.0 - 1.0;
    vec3 ro = u_ShadowOrigin + u_ShadowRight * (ndc.x * u_ShadowExtent.x)
                              + u_ShadowUp * (ndc.y * u_ShadowExtent.x);
    imageStore(u_ShadowMapOut, px, vec4(poolDepth(ro), 0.0, 0.0, 1.0));
}

// Sample the ACTIVE sun or moon pool at world point p: 1.0 if light from the pool's
// direction reaches p (depth test in the pool's ortho space), 0.0 if terrain blocks.
// inBounds is set when p projects inside the pool's ortho plane — used by the shaft
// march to early-out once both pools are out of coverage.
float poolVis(vec3 p, vec3 origin, vec3 right, vec3 up, vec3 dir, sampler2D tex, out bool inBounds) {
    vec3 d = p - origin;
    vec2 uvw = vec2(dot(d, right) / (2.0 * u_ShadowExtent.x) + 0.5,
                    dot(d, up) / (2.0 * u_ShadowExtent.x) + 0.5);
    inBounds = (uvw.x >= 0.0 && uvw.y >= 0.0 && uvw.x <= 1.0 && uvw.y <= 1.0);
    if (!inBounds) return 0.0;
    float pDepth = -dot(d, dir) / u_ShadowExtent.y;
    return (pDepth <= texture(tex, uvw).r + 0.004) ? 1.0 : 0.0;
}

// Volumetric god rays: march the primary ray, accumulating light scattered toward
// the camera from the active sun pool (day) and moon pool (night). Only rays with a
// positive dot against a lit source contribute (cheap early-out for the rest).
vec3 marchLightShafts(vec3 ro, vec3 rd, float tMax, Atmosphere at) {
    vec3 acc = vec3(0.0);
    float sunDot = dot(rd, at.sunDir);
    float moonDot = dot(rd, at.moonDir);
    float sunLit = (at.sunColor.x + at.sunColor.y + at.sunColor.z);
    float moonLit = (at.moonColor.x + at.moonColor.y + at.moonColor.z);
    if ((sunDot <= 0.05 || sunLit <= 0.001) && (moonDot <= 0.05 || moonLit <= 0.001)) return acc;
    bool sunActive = sunDot > 0.05 && sunLit > 0.001;
    bool moonActive = moonDot > 0.05 && moonLit > 0.001;
    const int STEPS = 14;
    float step = tMax / float(STEPS);
    float t = step * 0.5;
    for (int i = 0; i < STEPS; i++) {
        vec3 p = ro + rd * t;
        // Inactive sources count as out-of-bounds so the break below also fires
        // when only ONE pool is active (e.g. daytime sun-only shafts).
        bool sunOob = !sunActive, moonOob = !moonActive;
        if (sunActive) {
            float vis = poolVis(p, u_ShadowOrigin, u_ShadowRight, u_ShadowUp, u_ShadowSunDir, u_SunPoolTex, sunOob);
            // Deterministic world-space density + distance decay: shafts read as
            // soft glowing air instead of uniform slices (cartoon volumetric).
            float density = 0.6 + 0.4 * hash12(p.xz * 0.25);
            acc += at.sunColor * vis * sunDot * step * 0.010 * density * exp(-t * 0.012);
        }
        if (moonActive) {
            float vis = poolVis(p, u_MoonPoolOrigin, u_MoonPoolRight, u_MoonPoolUp, u_MoonPoolDir, u_MoonPoolTex, moonOob);
            acc += at.moonColor * vis * moonDot * step * 0.008;
        }
        // Beyond both pools' ortho coverage every remaining sample is 0 — stop
        // marching instead of burning the tail steps on guaranteed misses.
        if (sunOob && moonOob) break;
        t += step;
    }
    return acc;
}

// Dynamic point lights (added via /light). Accumulates diffuse + soft shadow.
vec3 pointLightContrib(vec3 p, vec3 n) {
    vec3 acc = vec3(0.0);
    // Defense in depth: clamp the count so a corrupt/oversized header can never
    // drive this loop to billions of iterations (GPU hang / frozen screen).
    int npl = min(numPointLights, 16);
    for (int i = 0; i < npl; i++) {
        PointLight L = pointLights[i];
        vec3 toL = L.position - p;
        float d2 = dot(toL, toL);
        if (d2 > L.radius * L.radius || d2 < 1e-4) continue;
        float d = sqrt(d2);
        vec3 ldir = toL / d;
        float ndl = max(0.0, dot(n, ldir));
        float att = 1.0 - d / L.radius; att *= att;
        // Skip the shadow-ray DDA entirely for faces that would receive nothing
        // (backfacing or fully attenuated) — the old code traced fastShadow
        // unconditionally for every light in range.
        if (ndl <= 0.0 || att <= 0.0) continue;
        if (fastShadow(p + n * 0.02, ldir, d) > 0.5) {
            // Cartoon 2-tone point light: lit face = full color, grazing/shadowed
            // faces = nothing (soft shadows from fastShadow are preserved; both
            // transitions are smooth so the light never "pops" or fries).
            acc += L.color * (L.intensity * smoothstep(0.15, 0.4, ndl) * smoothstep(0.0, 0.15, att));
        }
    }
    return acc;
}

void main() {
    if (u_ShadowPass == 1) { genLightPool(); return; }
    ivec2 px = ivec2(gl_GlobalInvocationID.xy); ivec2 sz = imageSize(imgOutput);
    if (any(greaterThanEqual(px, sz))) return;
    vec2 ndc = ((vec2(px) + 0.5) / vec2(sz)) * 2.0 - 1.0;
    vec3 rd = normalize(camForward + ndc.x * (float(sz.x)/sz.y) * camRight + ndc.y * camUp);
    
    vec4 uiCol = texture(u_UITexture, (vec2(px) + 0.5) / vec2(sz));
    if (uiCol.a >= 0.99) { imageStore(imgOutput, px, vec4(linearToSrgb(uiCol.rgb), 1.0)); return; }

    // Atmosphere pre-computed on CPU (AtmosphereRenderer) — avoids per-pixel computation
    Atmosphere at;
    at.sunDir = u_SunDir;
    at.moonDir = u_MoonDir;
    at.sunColor = u_SunColor;
    at.moonColor = u_MoonColor;
    at.skyZenith = u_SkyZenith;
    at.skyHorizon = u_SkyHorizon;
    at.ambient = u_Ambient;
    bool underWater = u_UnderWater != 0; // camera eye clipped inside a water block
    // Camera-clipped flag: the eye voxel is bit-solid — read directly from the
    // GPU pools using the IDENTICAL expression the per-voxel DDA uses to test
    // solidity. Self-consistent by construction: the stretched interior-face
    // planes appear exactly when the DDA hits this voxel at t≈0, i.e. exactly
    // when this bit is set — so the fix can never silently fail to engage.
    camClipped = false;
    {
        ivec3 eb = _camBlock;
        uint es = chunkSlots[(eb.x >> 4) | ((eb.y >> 4) << 7) | ((eb.z >> 4) << 14)];
        if (es != EMPTY) {
            int ebi = (eb.x & 15) | ((eb.y & 15) << 4) | ((eb.z & 15) << 8);
            camClipped = (bitmasks[(es << 7u) | uint(ebi >> 5)] & (1u << (ebi & 31))) != 0u;
        }
    }
    vec3 final = vec3(0.0), throu = vec3(1.0), ro = camPos; bool skip = false;
    vec3 godRd = rd; float godT = 96.0; // primary ray for god-ray marching
    // Fog/haze color is constant per pixel (rd and `at` never change across
    // bounces) — hoisted so the full GetSky() evaluation runs once, not per bounce.
    vec3 haze = hazeColor(rd, at);
    uint lastMediumTag = 0xFFFFFFFFu; // Track last translucent medium tag to skip same-medium faces

    // ── Semi-transparent placement preview (ghost) ──
    // The targeted cell is empty; draw the block being placed as a translucent
    // overlay there (Create-style ghost), then let the ray continue through to
    // the real surface behind it. Composited first (throu==1) so the opaque block
    // behind shows through at (1 - ghostAlpha).
    if (u_PreviewBlock >= 0) {
        vec3 gMin = vec3(u_PreviewPos) + vec3(0.002);
        vec3 gMax = vec3(u_PreviewPos) + vec3(0.998);
        float gNear, gFar;
        if (intersectAABB(camPos, rd, gMin, gMax, gNear, gFar) && gNear > 0.0 && gFar > gNear) {
            vec3 gp = camPos + rd * gNear;
            vec3 gn;
            if      (abs(gp.x - gMin.x) < 1e-3) gn = vec3(-1.0, 0.0, 0.0);
            else if (abs(gp.x - gMax.x) < 1e-3) gn = vec3( 1.0, 0.0, 0.0);
            else if (abs(gp.y - gMin.y) < 1e-3) gn = vec3( 0.0,-1.0, 0.0);
            else if (abs(gp.y - gMax.y) < 1e-3) gn = vec3( 0.0, 1.0, 0.0);
            else if (abs(gp.z - gMin.z) < 1e-3) gn = vec3( 0.0, 0.0,-1.0);
            else                                 gn = vec3( 0.0, 0.0, 1.0);
            int gface = (gn.y > 0.9) ? 1 : ((gn.y < -0.9) ? 0 : ((gn.z < -0.9) ? 2 : ((gn.z > 0.9) ? 3 : ((gn.x < -0.9) ? 4 : 5))));
            ivec4 gd0 = texelFetch(u_BlockData, u_PreviewBlock * 4);
            ivec4 gd1 = texelFetch(u_BlockData, u_PreviewBlock * 4 + 1);
            int gtex = faceTex(gface, gd0, gd1);
            vec2 guv;
            if (abs(gn.x) > 0.5)      guv = vec2(fract(gp.z), 1.0 - fract(gp.y));
            else if (abs(gn.y) > 0.5) guv = vec2(fract(gp.x), fract(gp.z));
            else                      guv = vec2(fract(gp.x), 1.0 - fract(gp.y));
            vec4 gtexel = texture(u_BlockTextures, vec3(guv, float(gtex)));
            if (gtexel.a > 0.05) {
                const float GA = 0.45; // ghost opacity
                float gsun = max(0.0, dot(gn, at.sunDir));
                vec3 gbeam = at.ambient * 0.7 + at.sunColor * celRamp(gsun) * 0.8;
                final += gtexel.rgb * gbeam * GA;
                throu *= (1.0 - GA);
            }
            ro = camPos + rd * (gFar + 0.004);
            skip = true;
        }
    }


    for (int b = 0; b < 2; b++) {  // reduced from 4 → 2 bounces for perf
        gMapPreviewValid = false; // fresh per trace: only the current ray's EMPTY crossing counts
        float t; vec3 n; uint voxel, eTex, wirePower, wireConn, kineticActive, kineticReverse, facing; vec2 eUv; bool isEnt, isHpBar; float hpRatio; int aabbIdx; int entIdx; float entEmissive; int craftingIdx; ivec4 blockData1; ivec3 gearOrigin; int gearShaft = 0;
        // Camera eye clipped inside a solid voxel: treat that voxel (buffer-relative
        // _camBlock, the cell the eye is in) as air until the first real hit — the
        // ray passes through it and hits the next surface at its true distance, so
        // its interior faces never paint the stretched block texture across the
        // view: a normal-scale wall when buried, or the outside when the voxel sits
        // at the terrain surface. No ray offset; the airVoxel sentinel restores
        // normal solidity on every later trace. Water has its own skipNearWater pass.
        bool skipFirstBounce = skip;
        ivec3 airVoxel = (b == 0 && camClipped) ? _camBlock : ivec3(0x7FFFFFFF);
        if (!traceAll(ro, rd, skipFirstBounce, airVoxel, lastMediumTag, t, n, voxel, eTex, eUv, isEnt, isHpBar, hpRatio, wirePower, wireConn, aabbIdx, entIdx, entEmissive, craftingIdx, blockData1, kineticActive, kineticReverse, facing, gearOrigin, gearShaft)) {
            // Map preview: a downward ray that fell through unloaded chunks shows the
            // simplified biome view instead of sky; beyond the world border the
            // preview texel is void so the map stops working there.
            final += throu * (gMapPreviewValid ? gMapPreviewCol : GetSky(rd, at));
            break;
        }
        int waterEff = (blockData1.w >> 10) & 0xF;
        bool waterHit = !isEnt && craftingIdx < 0 && waterEff == 2 && voxel != 21u;
        bool skipNearWater = underWater && b == 0 && waterHit;
        // Nearest NON-water surface bounds god-ray marching + underwater fog (the
        // camera's own water voxel face at t≈0 is skipped, as is a water surface).
        if (!waterHit && t < godT) godT = t;
        
        vec3 hp = ro + rd * t, alb; float trans = 0, refl = 0;
        vec3 beam = vec3(0.0); // hoisted — assigned in each hit-type path below
        // Crafting item: 3D miniature block rendered with block's face textures
        if (craftingIdx >= 0) {
            int blockId = floatBitsToInt(craftingItems[craftingIdx].position.w);
            vec3 itemPos = craftingItems[craftingIdx].position.xyz;
            float scale = craftingItems[craftingIdx].blockInfo.x;
            float halfScale = scale * 0.5;
            float itemSpin = craftingItems[craftingIdx].blockInfo.y;
            vec3 localPos = hp - itemPos;
            // Transform world-space localPos into the rotated block frame so the texture
            // appears locked to the geometry as it spins. Inverse of rotateY(theta) is
            // rotateY(-theta). Also inverse-rotate the world-space hit normal `n` so the
            // face-index chain below (which keys off axis-aligned components) picks the
            // correct block-frame face; otherwise non-uniform blocks (logs, crafting_table,
