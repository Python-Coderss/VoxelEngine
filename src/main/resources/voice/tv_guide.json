  "channels": [
    {
      "id": 0,
      "callsign": "OFF",
      "name": "Static / Off-Air",
      "tagline": "Please stand by",
      "tint": "#8A8A8A",
      "programmes": [
        {
          "name": "Test Card",
          "duration": 30,
          "lines": [
            {
              "at": 0,
              "text": "Hello? Is this thing on? Testing, testing... good, still working!",
              "topic": "SMALLTALK",
              "emotion": "neutral",
              "cue": "static_hum",
              "clip": "addon:oreville_vn:axwsxe"
            },
            {
              "at": 11,
              "text": "Hello? Can you hear my voice? I am the wind!",
              "topic": "SMALLTALK",
              "emotion": "neutral",
              "clip": "addon:oreville_vn:cxcpvx"
            },
            {
              "at": 20,
              "text": "Thank you! I shall now report on important things!",
              "topic": "GREETING",
              "emotion": "neutral",
              "cue": "clock_chime",
              "clip": "addon:oreville_vn:jrxfpn"
            }
          ]
        },
        {
          "name": "Colour Bars & Tone",
          "duration": 24,
          "lines": [
            {
              "at": 0,
              "text": "Oooh, I like this colour. I want to stand close to it! Surely nothing bad will happen if I do!",
              "topic": "SHINY",
              "emotion": "happy",
              "cue": "ident_sung",
              "clip": "addon:oreville_vn:inrjmx"
            },
            {
              "at": 14,
              "text": "Whoa, that's so sparkly. ...I've never seen something so magnificent!",
              "topic": "ADMIRE",
              "emotion": "happy",
              "clip": "addon:oreville_vn:aaiobx"
            }
          ]
        }
      ]
    },
    {
      "id": 1,
      "callsign": "VSN",
      "name": "Villager Shopping Network",
      "tagline": "Deals, hrmm, now",
      "tint": "#E0B050",
      "programmes": [
        {
          "name": "Emerald Hour",
          "duration": 42,
          "lines": [
            {
              "at": 0,
              "text": "Greetings, traveler! My Llamas and I bring wares from afar!",
              "topic": "GREETING",
              "emotion": "happy",
              "cue": "vsn_jingle",
              "clip": "addon:oreville_vn:nprhjx"
            },
            {
              "at": 7,
              "text": "Right here! Best trades in the village as far as you're aware.",
              "topic": "ADMIRE",
              "emotion": "happy",
              "clip": "addon:oreville_vn:apgvnt"
            },
            {
              "at": 14,
              "text": "That's coming out of the village budget! My budget!",
              "topic": "ARGUE",
              "emotion": "angry",
              "cue": "price_sting",
              "clip": "addon:oreville_vn:acgecn"
            },
            {
              "at": 22,
              "text": "Juuust getting all my trades back! Get those Emeralds ready!",
              "topic": "GOSSIP",
              "emotion": "happy",
              "clip": "addon:oreville_vn:amwyug"
            },
            {
              "at": 30,
              "text": "Satisfied with our transaction, I hope? Run along now!",
              "topic": "GREETING",
              "emotion": "happy",
              "clip": "addon:oreville_vn:adpewo"
            },
            {
              "at": 37,
              "text": "Exotic goods! Questionable value! Limited time before I vanish mysteriously!",
              "topic": "BLUFF",
              "emotion": "happy",
              "clip": "addon:oreville_vn:wxtbks"
            }
          ]
        },
        {
          "name": "Clearance Barn",
          "duration": 36,
          "lines": [
            {
              "at": 0,
              "text": "You came at the right time, odd citizen! Everything is on special discount today! It's not really.",
              "topic": "ADMIRE",
              "emotion": "happy",
              "cue": "clearance_bed",
              "clip": "addon:oreville_vn:qkuepa"
            },
            {
              "at": 12,
              "text": "Who needs a house when you could have Llamas?",
              "topic": "BLUFF",
              "emotion": "happy",
              "clip": "addon:oreville_vn:agzmhi"
            },
            {
              "at": 21,
              "text": "I wouldn't trade with you for a million Emeralds! u.. uh.. ...unless?",
              "topic": "ARGUE",
              "emotion": "neutral",
              "cue": "price_sting",
              "clip": "addon:oreville_vn:avtgfw"
            },
            {
              "at": 29,
              "text": "This is exactly why I can't trust anyone in this village. Nobody appreciates quality merchandise.",
              "topic": "GOSSIP",
              "emotion": "neutral",
              "clip": "addon:oreville_vn:ztvcpx"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "callsign": "WX",
      "name": "Weather & Time",
      "tagline": "Every hour on the hour",
      "tint": "#60A0E0",
      "programmes": [
        {
          "name": "Hourly Weather Watch",
          "duration": 34,
          "lines": [
            {
              "at": 0,
              "text": "Yep, that's the same sun as yesterday.",
              "topic": "GREETING",
              "emotion": "happy",
              "cue": "weather_jingle",
              "clip": "addon:oreville_vn:bcujjf"
            },
            {
              "at": 7,
              "text": "Hmmm, it's a bit chilly today!",
              "topic": "SMALLTALK",
              "emotion": "neutral",
              "clip": "addon:oreville_vn:luocqa"
            },
            {
              "at": 14,
              "text": "Is that what the sky is made of? I always wondered what the sky was made of.",
              "topic": "SMALLTALK",
              "emotion": "neutral",
              "clip": "addon:oreville_vn:ydcnpb"
            },
            {
              "at": 24,
              "text": "Oooh, a new hour has begun, fellow Villager! I felt it go 'bong' inside my head. I hope that is normal.",
              "topic": "SHINY",
              "emotion": "happy",
              "cue": "clock_chime",
              "clip": "addon:oreville_vn:atpocd"
            },
            {
              "at": 30,
              "text": "The Bell hasn't rung yet. That's good.",
              "topic": "FORGET",
              "emotion": "sad",
              "clip": "addon:oreville_vn:flrjrd"
            }
          ]
        },
        {
          "name": "Storm Warning Bulletin",
          "duration": 30,
          "lines": [
            {
              "at": 0,
              "text": "The sky is leaking! THE SKY IS LEAKING!",
              "topic": "PANIC",
              "emotion": "scared",
              "cue": "storm_warning",
              "clip": "addon:oreville_vn:vhaqyz"
            },
            {
              "at": 8,
              "text": "Do not worry, the rain cannot reach me. I am walking very fast.",
              "topic": "BLUFF",
              "emotion": "neutral",
              "clip": "addon:oreville_vn:arfgww"
            },
            {
              "at": 17,
              "text": "Aah, the rain. It hurts!",
              "topic": "PANIC",
              "emotion": "scared",
              "clip": "addon:oreville_vn:aocpgw"
            },
            {
              "at": 24,
              "text": "Run, legs, run! The clouds are angry!",
              "topic": "PANIC",
              "emotion": "scared",
              "clip": "addon:oreville_vn:ukodjr"
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "callsign": "VNN",
      "name": "VNN Villager News",
      "tagline": "The testificate evening news",
      "tint": "#C05050",
      "programmes": [
        {
          "name": "VNN Nightly",
          "duration": 48,
          "lines": [
            {
              "at": 0,
              "text": "Da Da Da Daaa Daa Da Da Da Daaa Da Villager News!",
              "topic": "GREETING",
              "emotion": "happy",
              "cue": "vnn_theme",
              "clip": "addon:oreville_vn:dwigoh"
            },
            {
              "at": 8,
              "text": "Breaking News! A local citizen spots a celebrity around the village. Over to Villager #9.... ...Villager #9?",
              "topic": "PANIC",
              "emotion": "scared",
              "cue": "headline_sting",
              "clip": "addon:oreville_vn:iajdxy"
            },
            {
              "at": 21,
              "text": "A Creeper! My Emeralds! My Emeralds!",
              "topic": "PANIC",
              "emotion": "scared",
              "clip": "addon:oreville_vn:azbrdi"
            },
            {
              "at": 28,
              "text": "Look at that, a citizen is doing journalism! Villager News is proud!",
              "topic": "ADMIRE",
              "emotion": "happy",
              "clip": "addon:oreville_vn:jcsvai"
            },
            {
              "at": 35,
              "text": "Nobody likes you, Testificate Man!",
              "topic": "ARGUE",
              "emotion": "angry",
              "clip": "addon:oreville_vn:bcfzqh"
            },
            {
              "at": 41,
              "text": "Well, that's the end of that. Better luck next world!",
              "topic": "GREETING",
              "emotion": "neutral",
              "cue": "vnn_signoff",
              "clip": "addon:oreville_vn:ygnazn"
            }
          ]
        },
        {
          "name": "Field Report: The Nether",
          "duration": 40,
          "lines": [
            {
              "at": 0,
              "text": "Netherite? You went to the Nether? On purpose? With those legs?",
              "topic": "BLUFF",
              "emotion": "neutral",
              "cue": "headline_sting",
              "clip": "addon:oreville_vn:xnrkkj"
            },
            {
              "at": 10,
              "text": "It glows, but there's no fire... It's magic!",
              "topic": "SHINY",
              "emotion": "happy",
              "clip": "addon:oreville_vn:bcexbf"
            },
            {
              "at": 19,
              "text": "A Ghast that is happy! This is much better than the other ones!",
              "topic": "ADMIRE",
              "emotion": "happy",
              "clip": "addon:oreville_vn:pnjvoo"
            },
            {
              "at": 27,
              "text": "Don't panic, don't panic, don't panic. OH NO! I'm panicking!",
              "topic": "PANIC",
              "emotion": "scared",
              "clip": "addon:oreville_vn:afwvki"
            },
            {
              "at": 35,
              "text": "Hmmm, safe travels.",
              "topic": "GREETING",
              "emotion": "neutral",
              "cue": "vnn_signoff",
              "clip": "addon:oreville_vn:avvtrs"
            }
          ]
        },
        {
          "name": "Cultural Corner",
          "duration": 32,
          "lines": [
            {
              "at": 0,
              "text": "Excuse me, pardon me, Villager #9 coming through! Big story unfolding somewhere, probably!",
              "topic": "GOSSIP",
              "emotion": "neutral",
              "cue": "station_ident",
              "clip": "addon:oreville_vn:odqfly"
            },
            {
              "at": 10,
              "text": "Jobs are just a social construct, who needs one... Oh, I'm so poor.",
              "topic": "GOSSIP",
              "emotion": "sad",
              "clip": "addon:oreville_vn:aqebkc"
            },
            {
              "at": 19,
              "text": "You look how Monday feels, strange Villager. That is a compliment. I think.",
              "topic": "SMALLTALK",
              "emotion": "neutral",
              "clip": "addon:oreville_vn:azhjor"
            },
            {
              "at": 28,
              "text": "If anyone sees a story, please flag down your local Villager #9! That's me!",
              "topic": "BLUFF",
              "emotion": "happy",
              "clip": "addon:oreville_vn:yybsnf"
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "callsign": "VMC",
      "name": "Villager Music Channel",
      "tagline": "All hrmm, all day",
      "tint": "#B070D0",
      "programmes": [
        {
          "name": "Hrmm (Extended Mix)",
          "duration": 30,
          "lines": [
            {
              "at": 0,
              "text": "We don't need these Juke-in-the-boxes! We make our own music, ACAPELLA!",
              "topic": "GREETING",
              "emotion": "happy",
              "cue": "vmc_theme",
              "clip": "addon:oreville_vn:cknfpi"
            },
            {
              "at": 10,
              "text": "*Singing* ooo standing in my house until the morning coz I don't have a Bed... ...I am very sleepy...",
              "topic": "SHINY",
              "emotion": "happy",
              "cue": "vmc_track_one",
              "clip": "addon:oreville_vn:qidzvc"
            },
            {
              "at": 22,
              "text": "And I would walk a few blocks here then will walk a few blocks more DA DA DA!",
              "topic": "SMALLTALK",
              "emotion": "happy",
              "clip": "addon:oreville_vn:dkotzz"
            }
          ]
        },
        {
          "name": "Emerald Nights",
          "duration": 34,
          "lines": [
            {
              "at": 0,
              "text": "Ooh, I love that song! It's the one that goes... mm... mmm-mm... yes, that one exactly.",
              "topic": "SHINY",
              "emotion": "happy",
              "cue": "vmc_track_two",
              "clip": "addon:oreville_vn:qseswq"
            },
            {
              "at": 13,
              "text": "MUSIC! Everyone, the box is singing again! Form a circle and wobble respectfully!",
              "topic": "ADMIRE",
              "emotion": "happy",
              "clip": "addon:oreville_vn:bphivd"
            },
            {
              "at": 25,
              "text": "Yay! Fireworks!",
              "topic": "SHINY",
              "emotion": "happy",
              "cue": "price_sting",
              "clip": "addon:oreville_vn:ayfugo"
            }
          ]
        },
        {
          "name": "The Late Set",
          "duration": 28,
          "lines": [
            {
              "at": 0,
              "text": "Do do do dooo do do do dooooo",
              "topic": "GOSSIP",
              "emotion": "neutral",
              "cue": "ident_sung",
              "clip": "addon:oreville_vn:lnecvu"
            },
            {
              "at": 12,
              "text": "I feel like I haven't slept at all.",
              "topic": "FORGET",
              "emotion": "sad",
              "cue": "vmc_track_one",
              "clip": "addon:oreville_vn:bcyujo"
            },
            {
              "at": 22,
              "text": "Na na na na na na na Testificate Man! *singing*",
              "topic": "SMALLTALK",
              "emotion": "happy",
              "clip": "addon:oreville_vn:fdjjlo"
            }
          ]
        }
      ]
    },
    {
      "id": 5,
      "callsign": "NAT",
      "name": "Villager Geographic",
      "tagline": "The wild, explained slowly",
      "tint": "#5FA060",
      "programmes": [
        {
          "name": "Big Sniffing Creature",
          "duration": 40,
          "lines": [
            {
              "at": 0,
              "text": "Oh, a Sniffer! It's sniffing about for seeds, I bet.",
              "topic": "BLUFF",
              "emotion": "neutral",
              "cue": "nature_bed",
              "clip": "addon:oreville_vn:boeylz"
            },
            {
              "at": 9,
              "text": "Look! It is the big sniffing creature with no eyes!",
              "topic": "SHINY",
              "emotion": "happy",
              "cue": "nature_sting",
              "clip": "addon:oreville_vn:aohwmn"
            },
            {
              "at": 18,
              "text": "It sniffs the ground. Perhaps it has lost something?",
              "topic": "FORGET",
              "emotion": "sad",
              "clip": "addon:oreville_vn:dravzc"
            },
            {
              "at": 26,
              "text": "Since when do trees have eyes?",
              "topic": "FORGET",
              "emotion": "neutral",
              "clip": "addon:oreville_vn:afoqfa"
            },
            {
              "at": 34,
              "text": "It hops, it eats blocks, and it reeks. A most fascinating creature!",
              "topic": "BLUFF",
              "emotion": "neutral",
              "clip": "addon:oreville_vn:glvrkw"
            }
          ]
        },
        {
          "name": "Domesticated Canine",
          "duration": 34,
          "lines": [
            {
              "at": 0,
              "text": "Is that a big dog or a small Horse?",
              "topic": "ADMIRE",
              "emotion": "happy",
              "cue": "nature_sting",
              "clip": "addon:oreville_vn:yxniit"
            },
            {
              "at": 9,
              "text": "Hey, a Wolf! I will pet it from very far away.",
              "topic": "MOB_COWARD",
              "emotion": "scared",
              "clip": "addon:oreville_vn:aubgib"
            },
            {
              "at": 19,
              "text": "Ooh! A tamed Wolf! With a collar and everything!",
              "topic": "SHINY",
              "emotion": "happy",
              "cue": "nature_bed",
              "clip": "addon:oreville_vn:nikuxf"
            },
            {
              "at": 28,
              "text": "A Sheep! Are you the one from my dreams?",
              "topic": "SHINY",
              "emotion": "happy",
              "clip": "addon:oreville_vn:afidfx"
            }
          ]
        },
        {
          "name": "The Deep Places",
          "duration": 36,
          "lines": [
            {
              "at": 0,
              "text": "A Bat! Are you lost from the cave, friend?",
              "topic": "BLUFF",
              "emotion": "neutral",
              "cue": "nature_bed",
              "clip": "addon:oreville_vn:ylunud"
            },
            {
              "at": 10,
              "text": "Ow my head, it hurts now!",
              "topic": "TRIP",
              "emotion": "sad",
              "cue": "headline_sting",
              "clip": "addon:oreville_vn:apljsf"
            },
            {
              "at": 20,
              "text": "There! An Enderman! Do not, I repeat, do not make eye contact!",
              "topic": "HUNT_CONFUSED",
              "emotion": "scared",
              "clip": "addon:oreville_vn:cvwmkr"
            },
            {
              "at": 30,
              "text": "I'm saved!",
              "topic": "CHICKEN_OUT",
              "emotion": "happy",
              "clip": "addon:oreville_vn:baclmq"
            }
          ]
        }
      ]
    },
    {
      "id": 6,
      "callsign": "KITCH",
