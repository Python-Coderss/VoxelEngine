<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion> 

    <groupId>com.voxel</groupId>
    <artifactId>fastpbrjava</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <lwjgl.version>3.3.3</lwjgl.version>
    </properties> 

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.lwjgl</groupId>
                <artifactId>lwjgl-bom</artifactId>
                <version>${lwjgl.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
            <classifier>natives-windows</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
            <classifier>natives-linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
            <classifier>natives-macos</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>natives-windows</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>natives-windows</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>natives-windows</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>natives-linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>natives-linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>natives-linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>natives-macos</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>natives-macos</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>natives-macos</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
            <classifier>natives-windows</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
            <classifier>natives-linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
            <classifier>natives-macos</classifier>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>1.10.5</version>
        </dependency>
        <dependency>
            <groupId>javazoom</groupId>
            <artifactId>jlayer</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.20.0</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Assets are huge (112 MB / ~12k files: the tutorial world alone is
              66 MB) but the code is small (300 files). By default the
              resources plugin re-copies every asset on EVERY compile and test,
              which dominated the build: a no-op `mvn compile` took 19 s.

              The game reads its assets from src/main/resources at runtime (a
              plain File-based loader, not a classpath one), so compile and test
              do not need target/classes populated with them at all. Only
              packaging a jar needs them bundled, so resource processing is
              bound to the `prepare-package` phase, which runs before
              maven-jar/shade but never during compile or surefire.

              Run `mvn package` (or `mvn -Prelease package`) to build a jar;
              for day-to-day work just run `mvn compile` / `mvn test`, which now
              only compile Java.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <!-- Disable the lifecycle's default process-resources copy. -->
                    <execution>
                        <id>default-resources</id>
                        <phase>none</phase>
                    </execution>
                    <!--
                      Surefire runs from target/classes and a few loaders
                      (VillagerNewsIntro, DialogueCatalog, ClipIndex, TvGuide)
                      resolve assets through the CLASSPATH, so the test phase does
                      need the small ones present. Only the resources the game
                      actually classpath-loads are copied here - the heavy
                      directories (tutorial_world 66 MB, the 8k model/texture
                      assets) are read from src/main/resources by File-based
                      loaders at runtime, so they stay out of the build entirely
                      and are only copied in full for the jar (below).
                    -->
                    <execution>
                        <id>copy-classpath-assets-for-tests</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <!-- Root-level JSON read via the classloader. -->
                                <resource>
                                    <directory>src/main/resources</directory>
                                    <includes>
                                        <include>dialogue.json</include>
                                        <include>create_content.json</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/main/resources/ai</directory>
                                    <targetPath>ai</targetPath>
                                    <includes>
                                        <include>**/*.json</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/main/resources/voice</directory>
                                    <targetPath>voice</targetPath>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/main/resources/ui</directory>
                                    <targetPath>ui</targetPath>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/main/resources/shaders</directory>
                                    <targetPath>shaders</targetPath>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-assets-for-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>resources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Run every test in one forked JVM, one test at a time.
                         The world/chunk tests each spin their own daemon
                         generation threads, so parallel forks would saturate
                         modest machines; keep it strictly single-threaded. -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <parallel>none</parallel>
                    <threadCount>1</threadCount>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!--
                      Java 8 target. Build ON JDK 8 (mvnw honours JAVA_HOME), which
                      makes source/target authoritative: JDK 8's javac links
                      against its own java.base, so the covariant NIO overrides
                      that broke Java 8 startup
                      (NoSuchMethodError: FloatBuffer.flip()Ljava/nio/FloatBuffer;)
                      cannot be emitted.

                      A "release" setting would pin the API too, but JDK 8's
                      javac rejects that flag entirely ("invalid flag: ..."), so
                      it is not used here: the pom must build on the same JDK the
                      game runs on. If you ever build on JDK 9+, add
                      release=8 (and drop it again before building on JDK 8).
                    -->
                    <source>1.8</source>
                    <target>1.8</target>
                    <!--
                      Maven 3.9 still reports "Changes detected - recompiling the
                      module! :source" and runs javac over all 300 files even when
                      the tree is untouched, so this does not fully take effect.
                      For a genuinely fast loop use build-fast.bat, which compiles
                      only the changed sources with plain javac.
                    -->
                    <useIncrementalCompilation>true</useIncrementalCompilation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.voxel.Main</mainClass>
                </configuration>
                <executions>
                    <!-- One-time dev tool: build the handcrafted tutorial world and
                         export it into src/main/resources/tutorial_world. Run with:
                         MAVEN_OPTS="-Xmx2g" ./mvnw compile exec:java@export-tutorial -->
                    <execution>
                        <id>export-tutorial</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.voxel.tools.TutorialWorldExporter</mainClass>
                        </configuration>
                    </execution>
                    <!-- Villager voice CLI: render dialogue lines from the
                         command line, e.g.
                         MAVEN_OPTS="-Xmx2g" ./mvnw compile exec:java@voice
                             -Dexec.args="...voice cli arguments here..." -->
                    <execution>
                        <id>voice</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>villager.voice.Main</mainClass>
                        </configuration>
                    </execution>
                    <!-- One-time dev tool: build the Point & Click demo world and
                         export it into src/main/resources/pointclick_world. Run with:
                         MAVEN_OPTS="-Xmx2g" ./mvnw compile exec:java@export-pointclick -->
                    <execution>
                        <id>export-pointclick</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.voxel.tools.PointClickWorldExporter</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.voxel.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Native debug symbols (onnxruntime ships a
                                             304 MB .pdb per platform) are not
                                             loaded at runtime. -->
                                        <exclude>**/*.pdb</exclude>
                                        <exclude>**/*.dSYM/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
